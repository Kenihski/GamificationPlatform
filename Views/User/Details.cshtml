
@model GamificationPlatform.ViewModels.UserDetailsViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<GamificationPlatform.Models.User> UserManager

@{
    ViewData["Title"] = "User Details";

    var challengeHistory = Model.ChallengeHistory.ToList();
}

<h2 class="my-4">@Model.User.UserName</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" class="alert alert-success" role="status">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mb-4">
    <p>
        <strong>Email:</strong>
        @Model.User.Email
    </p>

    <p>
        <strong>Role:</strong>

        @if (await UserManager.IsInRoleAsync(Model.User, "Admin"))
        {
            <span class="user-role-badge user-role-admin">
                Admin
            </span>
        }
        else
        {
            <span class="user-role-badge user-role-member">
                User
            </span>
        }
    </p>
</div>

<h3 class="mt-4">Created Challenges</h3>

@if (!Model.CreatedChallenges.Any())
{
    <div class="alert alert-info">
        This user has not created any challenges.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Challenge</th>
                    <th scope="col" class="text-center">Questions</th>
                    <th scope="col" class="text-center">Max Points</th>
                    <th scope="col" class="text-center">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var challenge in Model.CreatedChallenges)
                {
                    <tr>
                        <td>@challenge.Title</td>

                        <td class="text-center">
                            @challenge.Questions.Count
                        </td>

                        <td class="text-center">
                            @challenge.MaxPoints
                        </td>

                        <td class="text-center">
                            @if (challenge.IsPublished)
                            {
                                <span class="challenge-management-status challenge-management-status-published">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="challenge-management-status challenge-management-status-draft">
                                    Draft
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-nowrap gap-1 align-items-center my-challenges-actions">
                                <a asp-controller="Challenge"
                                   asp-action="Details"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <a asp-controller="Challenge"
                                   asp-action="Update"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>

                                <a asp-controller="Challenge"
                                   asp-action="Delete"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                                @if (!challenge.IsPublished)
                                {
                                    <form asp-controller="Challenge"
                                          asp-action="Publish"
                                          asp-route-id="@challenge.ChallengeId"
                                          method="post">
                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Publish
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Challenge"
                                          asp-action="Unpublish"
                                          asp-route-id="@challenge.ChallengeId"
                                          method="post">
                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Unpublish
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3 id="challengeHistoryHeading" class="mt-5 mb-4">
    Challenge History
</h3>

@if (!challengeHistory.Any())
{
    <div class="alert alert-info">
        This user has not completed any challenges yet.
    </div>
}
else
{
    <nav class="user-history-navigation"
         aria-labelledby="challengeHistoryHeading">

        <div class="user-history-navigation-grid">
            @for (var i = 0; i < challengeHistory.Count; i++)
            {
                var challenge = challengeHistory[i];

                <button type="button"
                        class="user-history-nav-button"
                        data-history-index="@i"
                        aria-controls="user-history-card-@i"
                        aria-pressed="@(i == 0 ? "true" : "false")">
                    @challenge.ChallengeTitle
                </button>
            }
        </div>

        @if (challengeHistory.Count > 12)
        {
            <div class="user-history-pagination">
                <button type="button"
                        id="historyPrevious"
                        class="btn btn-outline-primary"
                        disabled>
                    Previous
                </button>

                <span id="historyPageInfo" aria-live="polite">
                    Page 1 of @((challengeHistory.Count + 11) / 12)
                </span>

                <button type="button"
                        id="historyNext"
                        class="btn btn-outline-primary">
                    Next
                </button>
            </div>
        }
    </nav>

    <div class="user-challenge-history">
        @for (var i = 0; i < challengeHistory.Count; i++)
        {
            var challenge = challengeHistory[i];
            var attemptCount = challenge.Attempts.Count();

            <section id="user-history-card-@i"
                     class="user-history-card"
                     aria-labelledby="user-history-title-@i"
                     hidden="@(i != 0)">

                <div class="user-history-card-header">
                    <h4 id="user-history-title-@i">
                        @challenge.ChallengeTitle
                    </h4>

                    <span class="user-history-attempt-count">
                        @attemptCount @(attemptCount == 1 ? "attempt" : "attempts")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Status</th>
                                <th scope="col">Attempt</th>
                                <th scope="col">Time</th>
                                <th scope="col">Score</th>
                                <th scope="col">Completed</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var attempt in challenge.Attempts)
                            {
                                <tr>
                                    <td>
                                        @if (attempt.IsBest && attempt.IsLatest)
                                        {
                                            <strong>BEST / LATEST</strong>
                                        }
                                        else if (attempt.IsBest)
                                        {
                                            <strong>BEST</strong>
                                        }
                                        else if (attempt.IsLatest)
                                        {
                                            <strong>LATEST</strong>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Quiz"
                                           asp-action="AttemptDetails"
                                           asp-route-id="@attempt.ChallengeAttemptId">
                                            Attempt @attempt.AttemptNumber
                                        </a>
                                    </td>

                                    <td>@attempt.TimeUsed</td>

                                    <td>
                                        <strong>
                                            @attempt.Score / @challenge.MaxPoints
                                        </strong>
                                    </td>

                                    <td>@attempt.CompletedAt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
}

<a asp-controller="User"
   asp-action="Table"
   class="btn btn-outline-primary mt-4">
    Back to Users
</a>

@section Scripts
{
    <script src="~/js/userDetails.js" asp-append-version="true" defer></script>
}
