@model GamificationPlatform.ViewModels.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<h2 class="my-4">
    @Model.User.Username
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage"
         class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage"
         class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mb-4">
    <p>
        <strong>Email:</strong>
        @Model.User.Email
    </p>

    <p>
        <strong>Role:</strong>

        @if (Model.User.IsAdmin)
        {
            <span class="badge bg-danger">
                Admin
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                User
            </span>
        }
    </p>
</div>


<h3 class="mt-4">Created Challenges</h3>

@if (!Model.CreatedChallenges.Any())
{
    <div class="alert alert-info">
        This user has not created any challenges.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Challenge</th>
                <th>Questions</th>
                <th>Max Points</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var challenge in Model.CreatedChallenges)
            {
                <tr>
                    <td>
                        @challenge.Title
                    </td>

                    <td>
                        @challenge.Questions.Count
                    </td>

                    <td>
                        @challenge.MaxPoints
                    </td>

                    <td>
                        @if (challenge.IsPublished)
                        {
                            <span class="badge bg-success">
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Draft
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Challenge"
                           asp-action="Details"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-primary">
                            View
                        </a>

                        <a asp-controller="Challenge"
                           asp-action="Update"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-controller="Challenge"
                           asp-action="Delete"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                        @if (!challenge.IsPublished)
                        {
                            <form asp-controller="Challenge"
                                  asp-action="Publish"
                                  asp-route-id="@challenge.ChallengeId"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@Context.Request.Path" />

                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    Publish
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Challenge"
                                  asp-action="Unpublish"
                                  asp-route-id="@challenge.ChallengeId"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@Context.Request.Path" />

                                <button type="submit"
                                        class="btn btn-sm btn-dark">
                                    Unpublish
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }

        </tbody>
    </table>
}


<h3 class="mt-5">Challenge History</h3>

@if (!Model.ChallengeHistory.Any())
{
    <div class="alert alert-info">
        This user has not completed any challenges yet.
    </div>
}
else
{
    @foreach (var challenge in Model.ChallengeHistory)
    {
        <h5 class="mt-4">
            @challenge.ChallengeTitle
        </h5>

        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Status</th>
                    <th>Attempt</th>
                    <th>Time</th>
                    <th>Score</th>
                    <th>Completed</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var attempt in challenge.Attempts)
                {
                    <tr>
                        <td>
                            @if (attempt.IsBest &&
                                 attempt.IsLatest)
                            {
                                <strong>
                                    BEST / LATEST
                                </strong>
                            }
                            else if (attempt.IsBest)
                            {
                                <strong>
                                    BEST
                                </strong>
                            }
                            else if (attempt.IsLatest)
                            {
                                <strong>
                                    LATEST
                                </strong>
                            }
                        </td>

                        <td>
                            <a asp-controller="Quiz"
                               asp-action="AttemptDetails"
                               asp-route-id="@attempt.ChallengeAttemptId">

                                Attempt @attempt.AttemptNumber

                            </a>
                        </td>

                        <td>
                            @attempt.TimeUsed
                        </td>

                        <td>
                            <strong>
                                @attempt.Score /
                                @challenge.MaxPoints
                            </strong>
                        </td>

                        <td>
                            @attempt.CompletedAt
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    }
}


<a asp-controller="User"
   asp-action="Table"
   class="btn btn-secondary mt-3">
    Back to Users
</a>


@section Scripts
{
    <script src="~/js/userDetails.js" defer></script>
}