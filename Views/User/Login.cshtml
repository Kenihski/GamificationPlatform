@model GamificationPlatform.ViewModels.LoginViewModel

<h2>Login</h2>

<form asp-controller="User"
      asp-action="Login"
      method="post">

    @if (!ViewData.ModelState.IsValid)
    {
        var error = ViewData.ModelState[string.Empty]
            ?.Errors
            .FirstOrDefault()
            ?.ErrorMessage;

        if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">
                @error
            </div>
        }
    }

    <div class="mb-3">
        <label asp-for="Username"
               class="form-label">
            Username
        </label>

        <input asp-for="Username"
               class="form-control" />

        <span asp-validation-for="Username"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password"
               class="form-label">
            Password
        </label>

        <input asp-for="Password"
               class="form-control" />

        <span asp-validation-for="Password"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Login
    </button>

</form>