
@model GamificationPlatform.ViewModels.LeaderboardViewModel

@{
    ViewData["Title"] = "Leaderboard";
}

<div class="container mt-4 leaderboard-page">

    <div class="leaderboard-page-header">

        <p class="leaderboard-page-label">
            COMPETE & IMPROVE
        </p>

        <h1>
            🏆 Leaderboard
        </h1>

        <h4 class="mb-3">
            @Model.Challenge.Title
        </h4>

        <p class="leaderboard-page-description">
            Rankings are based on each user's first completed attempt
            in this challenge.
        </p>

    </div>

    @if (Model.Entries.Any())
    {
        <div class="leaderboard-table-container">

            <div class="table-responsive">

                <table class="table leaderboard-table align-middle">

                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>User</th>
                            <th>Score</th>
                            <th>Time</th>
                            <th>Completed</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var entry in Model.Entries)
                        {
                            <tr>

                                <td>
                                    <div class="leaderboard-rank">

                                        <span class="leaderboard-rank-number">
                                            @entry.Rank
                                        </span>

                                        @if (entry.Rank == 1)
                                        {
                                            <span class="leaderboard-medal" title="Gold">
                                                🥇
                                            </span>
                                        }
                                        else if (entry.Rank == 2)
                                        {
                                            <span class="leaderboard-medal" title="Silver">
                                                🥈
                                            </span>
                                        }
                                        else if (entry.Rank == 3)
                                        {
                                            <span class="leaderboard-medal" title="Bronze">
                                                🥉
                                            </span>
                                        }

                                    </div>
                                </td>

                                <td class="leaderboard-username">
                                    @entry.Username
                                </td>

                                <td class="leaderboard-points">
                                    @entry.Score / @Model.MaxPoints
                                </td>

                                <td>
                                    @if (entry.TimeUsed.HasValue)
                                    {
                                        if (entry.TimeUsed.Value.TotalMinutes >= 1)
                                        {
                                            <span>
                                                @Math.Round(entry.TimeUsed.Value.TotalMinutes) min
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @Math.Round(entry.TimeUsed.Value.TotalSeconds) sec
                                            </span>
                                        }
                                    }
                                </td>

                                <td>
                                    @entry.CompletedAt?.ToString("dd.MM.yyyy HH:mm")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No scores yet.
        </div>
    }

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.Challenge.ChallengeId"
       class="btn btn-outline-primary leaderboard-back-button mt-4">
        Back to Challenge
    </a>

</div>
