@model GamificationPlatform.ViewModels.HallOfFameViewModel

@{
    ViewData["Title"] = "Hall of Fame";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h1>🏆 Hall of Fame</h1>

        <p class="text-muted">
            See how the community ranks based on Achievement Points.
        </p>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Rank</th>
                    <th>User</th>
                    <th>Milestone</th>
                    <th>Achievements</th>
                    <th>AP</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <strong>
                                @user.Rank
                            </strong>
                        </td>

                        <td>
                            <a asp-controller="HallOfFame"
                               asp-action="Achievements"
                               asp-route-id="@user.UserId"
                               class="text-decoration-none fw-semibold">
                                @user.Username
                            </a>
                        </td>

                        <td>
                            <span class="me-1">
                                @user.MilestoneIcon
                            </span>

                            @user.MilestoneName
                        </td>

                        <td>
                            @user.AchievementCount
                        </td>

                        <td>
                            <strong>
                                @user.AchievementPoints
                            </strong>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>