@model GamificationPlatform.ViewModels.QuestionFormViewModel

@{
    var challenge =
        Model.Challenges.FirstOrDefault(c =>
            c.ChallengeId ==
            Model.Question.ChallengeId);
}

<h2>Update Question</h2>

<div class="alert alert-warning">
    <strong>Warning:</strong>
    Updating this question will reset all previous attempts
    and scores for this challenge.
</div>

<form asp-controller="Question"
      asp-action="Update"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <input type="hidden"
           asp-for="Question.QuestionId" />

    <input type="hidden"
           asp-for="Question.ChallengeId" />

    <div class="form-group mb-3">
        <label asp-for="Question.Title">
            Title
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Title"
               class="form-control" />

        <span asp-validation-for="Question.Title"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.QuestionType">
            Question Type
        </label>

        <span class="text-danger">*</span>

        <select asp-for="Question.QuestionType"
                class="form-control"
                id="questionType">

            <option value="SingleChoice">
                Single Choice
            </option>

            <option value="MultipleChoice">
                Multiple Choice
            </option>

            <option value="ShortAnswer">
                Short Answer
            </option>
        </select>

        <span asp-validation-for="Question.QuestionType"
              class="text-danger">
        </span>

        <small id="questionTypeHelp"
               class="form-text text-muted">
            Select one correct answer.
        </small>
    </div>

    <div class="form-group mb-3">
        <label for="descriptionSelect">
            Description
        </label>

        <select id="descriptionSelect"
                class="form-control">

            <option value="">
                -- No description --
            </option>

            <option value="Choose one correct answer.">
                Choose one correct answer.
            </option>

            <option value="One or more answers may be correct.">
                One or more answers may be correct.
            </option>

            <option value="Choose the best answer.">
                Choose the best answer.
            </option>

            <option value="Select all correct answers.">
                Select all correct answers.
            </option>

            <option value="Write the correct answer. Uppercase and lowercase letters are treated the same.">
                Write the correct answer. Uppercase and lowercase letters are treated the same.
            </option>

            <option value="custom">
                Custom description...
            </option>
        </select>

        <div id="customDescriptionContainer"
             class="mt-2"
             style="display: none;">

            <input type="text"
                   id="customDescription"
                   maxlength="500"
                   class="form-control"
                   placeholder="Enter description" />
        </div>

        <input type="hidden"
               asp-for="Question.Description"
               id="questionDescription" />

        <span asp-validation-for="Question.Description"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Points">
            Points
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Points"
               class="form-control" />

        <span asp-validation-for="Question.Points"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.ImageUrl">
            Image
        </label>

        <select asp-for="Question.ImageUrl"
                class="form-control"
                id="imageSelect">

            <option value="">
                -- No Image --
            </option>

            <option value="/images/Question_1.png">
                Question 1
            </option>

            <option value="/images/Question_2.png">
                Question 2
            </option>

            <option value="/images/Question_3.png">
                Question 3
            </option>

            <option value="/images/Question_4.png">
                Question 4
            </option>

            <option value="/images/Question_5.png">
                Question 5
            </option>

            <option value="/images/Question_6.png">
                Question 6
            </option>

            <option value="/images/Question_7.png">
                Question 7
            </option>

            <option value="/images/Question_8.png">
                Question 8
            </option>

            <option value="/images/Question_9.png">
                Question 9
            </option>

            <option value="/images/Question_10.png">
                Question 10
            </option>

            <option value="/images/Question_11.png">
                Question 11
            </option>

            <option value="/images/Question_12.png">
                Question 12
            </option>

            <option value="/images/Question_13.png">
                Question 13
            </option>
        </select>

        <span asp-validation-for="Question.ImageUrl"
              class="text-danger">
        </span>

        <div class="mt-3">
            <img id="imagePreview"
                 src=""
                 alt="Selected image preview"
                 style="width: 300px;
                        height: 180px;
                        object-fit: contain;
                        display: none;" />
        </div>
    </div>

    @* Challenge cannot be changed when editing a question. *@
    <div class="form-group mb-3">
        <label>
            Challenge
        </label>

        <input type="text"
               class="form-control"
               value="@challenge?.Title"
               readonly />
    </div>

    <hr />

    @* Used for Single Choice and Multiple Choice. *@
    <div id="choiceAnswerSection">
        <h4>Answer Options</h4>

        <span asp-validation-for="Options"
              class="text-danger">
        </span>

        <span asp-validation-for="CorrectOptions"
              class="text-danger">
        </span>

        <p class="text-muted">
            Enter between 2 and 4 answer options.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label>
                    Option @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="Options[i]"
                       class="form-control" />

                <div class="form-check mt-1">
                    <input type="checkbox"
                           name="CorrectOptions"
                           value="@i"
                           class="form-check-input correct-option"
                           id="correctOption@(i)"
                           checked="@Model.CorrectOptions.Contains(i)" />

                    <label class="form-check-label"
                           for="correctOption@(i)">
                        Correct answer
                    </label>
                </div>
            </div>
        }
    </div>

    @* Used for Short Answer questions. *@
    <div id="shortAnswerSection"
         style="display: none;">

        <h4>Accepted Answers</h4>

        <span asp-validation-for="AcceptedAnswers"
              class="text-danger">
        </span>

        <p class="text-muted">
            Enter between 1 and 4 accepted answers.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label>
                    Accepted Answer @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="AcceptedAnswers[i]"
                       class="form-control"
                       placeholder="Enter accepted answer" />
            </div>
        }
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Update Question
    </button>

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.Question.ChallengeId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-description.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-type.js"
            asp-append-version="true"
            defer></script>
}