@model GamificationPlatform.ViewModels.QuestionFormViewModel

@{
    ViewData["Title"] = "Update Question";

    var challenge = Model.Challenges.FirstOrDefault(c =>
        c.ChallengeId == Model.Question.ChallengeId);

    var myImages = ViewBag.MyImages as List<GamificationPlatform.Models.UserImage>
        ?? new List<GamificationPlatform.Models.UserImage>();

    var defaultImages = ViewData["DefaultImages"] as List<GamificationPlatform.Models.DefaultImage>
        ?? new List<GamificationPlatform.Models.DefaultImage>();

    var currentImage = Model.Question.ImageUrl ?? "";

    bool isMyImage = myImages.Any(image =>
        image.ImageUrl == currentImage);

    bool isDefaultImage = defaultImages.Any(image =>
        image.ImageUrl == currentImage);

    bool isOtherImage = !string.IsNullOrEmpty(currentImage)
        && !isMyImage
        && !isDefaultImage;

    string selectedCategory = "none";

    if (isMyImage)
    {
        selectedCategory = "my";
    }
    else if (isDefaultImage)
    {
        selectedCategory = "default";
    }
    else if (isOtherImage)
    {
        selectedCategory = "current";
    }
}

<h2>Update Question</h2>

<div class="alert alert-warning">
    <strong>Warning:</strong>
    Updating this question will reset all previous attempts
    and scores for this challenge.
</div>

<form asp-controller="Question"
      asp-action="Update"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <input type="hidden"
           asp-for="Question.QuestionId" />

    <input type="hidden"
           asp-for="Question.ChallengeId" />

    <div class="form-group mb-3">
        <label asp-for="Question.Title">
            Title
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Title"
               class="form-control" />

        <span asp-validation-for="Question.Title"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.QuestionType">
            Question Type
        </label>

        <span class="text-danger">*</span>

        <select asp-for="Question.QuestionType"
                class="form-control"
                id="questionType">

            <option value="SingleChoice">
                Single Choice
            </option>

            <option value="MultipleChoice">
                Multiple Choice
            </option>

            <option value="ShortAnswer">
                Short Answer
            </option>
        </select>

        <span asp-validation-for="Question.QuestionType"
              class="text-danger">
        </span>

        <small id="questionTypeHelp"
               class="form-text text-muted">
            Select one correct answer.
        </small>
    </div>

    <div class="form-group mb-3">
        <label for="descriptionSelect">
            Description
        </label>

        <select id="descriptionSelect"
                class="form-control">

            <option value="">
                -- No description --
            </option>

            <option value="Choose one correct answer.">
                Choose one correct answer.
            </option>

            <option value="One or more answers may be correct.">
                One or more answers may be correct.
            </option>

            <option value="Choose the best answer.">
                Choose the best answer.
            </option>

            <option value="Select all correct answers.">
                Select all correct answers.
            </option>

            <option value="Write the correct answer. Uppercase and lowercase letters are treated the same.">
                Write the correct answer. Uppercase and lowercase letters are treated the same.
            </option>

            <option value="custom">
                Custom description...
            </option>
        </select>

        <div id="customDescriptionContainer"
             class="mt-2 image-selection-hidden">

            <input type="text"
                   id="customDescription"
                   maxlength="500"
                   class="form-control"
                   placeholder="Enter description" />
        </div>

        <input type="hidden"
               asp-for="Question.Description"
               id="questionDescription" />

        <span asp-validation-for="Question.Description"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Explanation">
            Explanation (optional)
        </label>

        <textarea asp-for="Question.Explanation"
                  class="form-control"
                  rows="3"
                  maxlength="1000"
                  placeholder="Explain why the answer is correct"></textarea>

        <span asp-validation-for="Question.Explanation"
              class="text-danger">
        </span>

        <small class="form-text text-muted">
            This explanation is shown after the challenge has been submitted.
        </small>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Points">
            Points
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Points"
               class="form-control" />

        <span asp-validation-for="Question.Points"
              class="text-danger">
        </span>
    </div>

    @* Image selection *@
    <div class="form-group mb-3">
        <label for="imageCategorySelect">
            Image
        </label>

        <select id="imageCategorySelect"
                class="form-control">

            <option value="none"
                    selected="@(selectedCategory == "none")">
                No image
            </option>

            <option value="upload">
                Upload new image...
            </option>

            <option value="my"
                    selected="@(selectedCategory == "my")">
                My Images
            </option>

            <option value="default"
                    selected="@(selectedCategory == "default")">
                Default Images
            </option>

            @if (isOtherImage)
            {
                <option value="current"
                        selected="@(selectedCategory == "current")">
                    Current image
                </option>
            }
        </select>

        @* Upload new image *@
        <div id="uploadImageSection"
             class="mt-3 image-selection-hidden">

            <label for="imageUpload">
                Choose image
            </label>

            <input type="file"
                   name="imageUpload"
                   id="imageUpload"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="form-text text-muted">
                JPG, PNG or WebP. Maximum 5 MB.
            </small>
        </div>

        @* My Images *@
        <div id="myImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="myImagesSelect">
                My Images
            </label>

            <select id="myImagesSelect"
                    class="form-control">

                <option value="">
                    -- Select image --
                </option>

                @foreach (var image in myImages)
                {
                    <option value="@image.ImageUrl"
                            data-image-id="@image.UserImageId"
                            selected="@(image.ImageUrl == currentImage)">
                        @image.FileName
                    </option>
                }
            </select>

            <button type="button"
                    id="removeImageButton"
                    class="btn btn-link btn-sm text-secondary text-decoration-none image-selection-hidden">
                Remove image
            </button>
        </div>

        @* Default Images *@
        <div id="defaultImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="defaultImagesSelect">
                Default Images
            </label>

            <select id="defaultImagesSelect"
                    class="form-control">

                <option value="">
                    -- Select image --
                </option>

                @foreach (var image in defaultImages)
                {
                    <option value="@image.ImageUrl"
                            selected="@(image.ImageUrl == currentImage)">
                        @image.Name
                    </option>
                }
            </select>
        </div>

        <input asp-for="Question.ImageUrl"
               type="hidden"
               id="imageSelect" />

        <span asp-validation-for="Question.ImageUrl"
              class="text-danger">
        </span>

        <div class="mt-3">
            <img id="imagePreview"
                 src="@currentImage"
                 alt="Selected image preview"
                 class="image-preview" />
        </div>
    </div>

    @* Challenge cannot be changed when editing a question. *@
    <div class="form-group mb-3">
        <label>
            Challenge
        </label>

        <input type="text"
               class="form-control"
               value="@challenge?.Title"
               readonly />
    </div>

    <hr />

    @* Used for Single Choice and Multiple Choice. *@
    <div id="choiceAnswerSection">
        <h4>Answer Options</h4>

        <span asp-validation-for="Options"
              class="text-danger">
        </span>

        <span asp-validation-for="CorrectOptions"
              class="text-danger">
        </span>

        <p class="text-muted">
            Enter between 2 and 4 answer options.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label>
                    Option @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="Options[i]"
                       class="form-control" />

                <div class="form-check mt-1">
                    <input type="checkbox"
                           name="CorrectOptions"
                           value="@i"
                           class="form-check-input correct-option"
                           id="correctOption@(i)"
                           checked="@Model.CorrectOptions.Contains(i)" />

                    <label class="form-check-label"
                           for="correctOption@(i)">
                        Correct answer
                    </label>
                </div>
            </div>
        }
    </div>

    @* Used for Short Answer questions. *@
    <div id="shortAnswerSection"
         class="image-selection-hidden">

        <h4>Accepted Answers</h4>

        <span asp-validation-for="AcceptedAnswers"
              class="text-danger">
        </span>

        <p class="text-muted">
            Enter between 1 and 4 accepted answers.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label>
                    Accepted Answer @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="AcceptedAnswers[i]"
                       class="form-control"
                       placeholder="Enter accepted answer" />
            </div>
        }
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Update Question
    </button>

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.Question.ChallengeId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-description.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-type.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-form-validation.js"
            asp-append-version="true"
            defer></script>
}