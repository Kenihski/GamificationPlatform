@model GamificationPlatform.Models.Question

<h2>Delete Question</h2>

<div class="alert alert-warning mt-4">
    <p class="mb-2">
        <strong>Warning:</strong>
        Deleting this question will reset all previous attempts
        and scores for this challenge.
    </p>

    @if (Model.Challenge.IsPublished &&
         Model.Challenge.Questions.Count == 1)
    {
        <p class="mb-2">
            <strong>
                This is the last question in this published challenge.
            </strong>
        </p>

        <p class="mb-2">
            Deleting it will automatically unpublish the challenge.
        </p>
    }

    <p class="mb-0">
        Are you sure you want to delete this question?
    </p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">
            @Model.Title
        </h4>

        @if (!string.IsNullOrWhiteSpace(
            Model.Description))
        {
            <p class="card-text">
                @Model.Description
            </p>
        }

        <p>
            <strong>Challenge:</strong>
            @Model.Challenge.Title
        </p>

        <p>
            <strong>Question Type:</strong>

            @if (Model.QuestionType == "MultipleChoice")
            {
                <span>Multiple Choice</span>
            }
            else if (Model.QuestionType == "ShortAnswer")
            {
                <span>Short Answer</span>
            }
            else
            {
                <span>Single Choice</span>
            }
        </p>

        <p>
            <strong>Points:</strong>
            @Model.Points
        </p>

        @if (!string.IsNullOrWhiteSpace(
            Model.ImageUrl))
        {
            <div class="mb-3">
                <strong>Image:</strong>

                <br />

                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid mt-2"
                     style="max-width: 250px;" />
            </div>
        }

        <hr />

        @if (Model.QuestionType == "ShortAnswer")
        {
            <h5>Accepted Answers</h5>

            @foreach (var answer in Model.AcceptedAnswers)
            {
                <div class="mb-1">
                    <span>
                        ✓
                        <strong>
                            @answer.Text
                        </strong>
                    </span>
                </div>
            }
        }
        else
        {
            <h5>Answer Options</h5>

            @foreach (var option in Model.Options)
            {
                <div class="mb-1">
                    @if (option.IsCorrect)
                    {
                        <span>
                            ✓
                            <strong>
                                @option.Text
                            </strong>
                            (Correct)
                        </span>
                    }
                    else
                    {
                        <span>
                            ○ @option.Text
                        </span>
                    }
                </div>
            }
        }
    </div>
</div>

<form asp-controller="Question"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.QuestionId"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete Question
    </button>

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>