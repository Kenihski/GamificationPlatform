@model GamificationPlatform.Models.Question

<h2>Delete Question</h2>

<h4>Are you sure you want to delete this question?</h4>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Question
        </dt>

        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>

        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Points
        </dt>

        <dd class="col-sm-9">
            @Model.Points
        </dd>

        <dt class="col-sm-3">
            Image
        </dt>

        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     style="width: 200px; height: 120px; object-fit: contain;" />
            }
            else
            {
                <span>No image</span>
            }
        </dd>

    </dl>
</div>

<form asp-controller="Question"
      asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.QuestionId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Question"
       asp-action="Table"
       class="btn btn-secondary">
        Cancel
    </a>

</form>