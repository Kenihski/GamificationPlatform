@model GamificationPlatform.Models.Question

<h2>Delete Question</h2>


<div class="alert alert-warning mt-4">

    <strong>Warning:</strong>

    Deleting this question will reset all previous attempts
    and scores for this challenge.

    <br />

    Are you sure you want to delete this question?

</div>


<div class="card mb-4">

    <div class="card-body">

        <h4 class="card-title">
            @Model.Title
        </h4>


        @if (!string.IsNullOrWhiteSpace(
            Model.Description))
        {
            <p class="card-text">
                @Model.Description
            </p>
        }


        <p>
            <strong>Challenge:</strong>
            @Model.Challenge.Title
        </p>


        <p>
            <strong>Points:</strong>
            @Model.Points
        </p>


        @if (!string.IsNullOrWhiteSpace(
            Model.ImageUrl))
        {
            <div class="mb-3">

                <strong>Image:</strong>

                <br />

                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid mt-2"
                     style="max-width: 250px;" />

            </div>
        }


        <hr />


        <h5>Answer Options</h5>


        @foreach (var option in Model.Options)
        {
            <div class="mb-1">

                @if (option.IsCorrect)
                {
                    <span>
                        ✓
                        <strong>
                            @option.Text
                        </strong>
                        (Correct)
                    </span>
                }
                else
                {
                    <span>
                        ○ @option.Text
                    </span>
                }

            </div>
        }

    </div>

</div>


<form asp-controller="Question"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.QuestionId"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete Question
    </button>


    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>