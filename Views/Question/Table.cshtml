@model IEnumerable<GamificationPlatform.Models.Question>

<h1>List of Questions</h1>

<p class="text-muted">
    Overview of all questions in the system.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Question</th>
            <th>Description</th>
            <th>Points</th>
            <th>Challenge</th>
            <th>Owner</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var question in Model)
        {
            <tr>
                <td>
                    @question.QuestionId
                </td>

                <td>
                    @question.Title
                </td>

                <td>
                    @question.Description
                </td>

                <td>
                    @question.Points
                </td>

                <td>
                    <a asp-controller="Challenge"
                       asp-action="Details"
                       asp-route-id="@question.ChallengeId">
                        @question.Challenge.Title
                    </a>
                </td>

                <td>
                    <a asp-controller="User"
                       asp-action="Details"
                       asp-route-id="@question.Challenge.CreatedByUserId">
                        @question.Challenge.CreatedByUser.Username
                    </a>
                </td>

                <td>
                    @if (!string.IsNullOrEmpty(question.ImageUrl))
                    {
                        <img src="@question.ImageUrl"
                             alt="@question.Title"
                             style="width: 100px;
                                    height: 60px;
                                    object-fit: contain;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>

                <td class="text-nowrap">

                    <a asp-controller="Question"
                       asp-action="Update"
                       asp-route-id="@question.QuestionId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-controller="Question"
                       asp-action="Delete"
                       asp-route-id="@question.QuestionId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>