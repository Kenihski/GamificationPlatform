@model GamificationPlatform.ViewModels.QuestionFormViewModel

@{
    ViewData["Title"] = "Create New Question";

    var challenge = Model.Challenges.FirstOrDefault(c =>
        c.ChallengeId == Model.Question.ChallengeId);

    var myImages = ViewBag.MyImages as List<GamificationPlatform.Models.UserImage>
        ?? new List<GamificationPlatform.Models.UserImage>();

    var defaultImages = ViewData["DefaultImages"] as List<GamificationPlatform.Models.DefaultImage>
        ?? new List<GamificationPlatform.Models.DefaultImage>();
}

<h2>Create New Question</h2>

<div class="alert alert-warning">
    <strong>Note:</strong>
    Adding a new question will reset all previous attempts
    and scores for this challenge.
</div>

<form asp-controller="Question"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Title">
            Title
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Title"
               class="form-control" />

        <span asp-validation-for="Question.Title"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label for="questionType">
            Question Type
        </label>

        <span class="text-danger">*</span>

        <select asp-for="Question.QuestionType"
                class="form-control"
                id="questionType" aria-describedby="questionTypeHelp">

            <option value="SingleChoice">
                Single Choice
            </option>

            <option value="MultipleChoice">
                Multiple Choice
            </option>

            <option value="ShortAnswer">
                Short Answer
            </option>
        </select>

        <span asp-validation-for="Question.QuestionType"
              class="text-danger">
        </span>

        <small id="questionTypeHelp"
               class="form-text text-muted">
            Select one correct answer.
        </small>
    </div>

    <div class="form-group mb-3">
        <label for="descriptionSelect">
            Description
        </label>

        <select id="descriptionSelect" data-validation-for="Question.Description"
                class="form-control">

            <option value="">
                -- No description --
            </option>

            <option value="Choose one correct answer.">
                Choose one correct answer.
            </option>

            <option value="One or more answers may be correct.">
                One or more answers may be correct.
            </option>

            <option value="Choose the best answer.">
                Choose the best answer.
            </option>

            <option value="Select all correct answers.">
                Select all correct answers.
            </option>

            <option value="Write the correct answer. Uppercase and lowercase letters are treated the same.">
                Write the correct answer. Uppercase and lowercase letters are treated the same.
            </option>

            <option value="custom">
                Custom description...
            </option>
        </select>

        <div id="customDescriptionContainer"
             class="mt-2 image-selection-hidden">

            <label for="customDescription">Custom description</label>

            <input type="text"
                   id="customDescription" data-validation-for="Question.Description"
                   maxlength="500"
                   class="form-control"
                   placeholder="Enter description" />
        </div>

        <input type="hidden"
               asp-for="Question.Description"
               id="questionDescription" />

        <span asp-validation-for="Question.Description"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Explanation">
            Explanation (optional)
        </label>

        <textarea asp-for="Question.Explanation"
                  class="form-control"
                  rows="3"
                  maxlength="1000"
                  placeholder="Explain why the answer is correct"></textarea>

        <span asp-validation-for="Question.Explanation"
              class="text-danger">
        </span>

        <small class="form-text text-muted">
            This explanation is shown after the challenge has been submitted.
        </small>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Question.Points">
            Points
        </label>

        <span class="text-danger">*</span>

        <input type="number"
               name="Question.Points"
               id="Question_Points"
               value="@(Model.Question.Points == 0 ? "" : Model.Question.Points)"
               placeholder="0"
               min="1"
               class="form-control" />

        <span asp-validation-for="Question.Points"
              class="text-danger">
        </span>
    </div>

    @* Image selection *@
    <div class="form-group mb-3">
        <label for="imageCategorySelect">
            Image
        </label>

        <select id="imageCategorySelect" data-validation-for="Question.ImageUrl"
                class="form-control">

            <option value="none">
                No image
            </option>

            <option value="upload">
                Upload new image...
            </option>

            <option value="my">
                My Images
            </option>

            <option value="default">
                Default Images
            </option>
        </select>

        @* Upload new image *@
        <div id="uploadImageSection"
             class="mt-3 image-selection-hidden">

            <label for="imageUpload">
                Choose image
            </label>

            <input type="file"
                   name="imageUpload"
                   id="imageUpload"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="form-text text-muted">
                JPG, PNG or WebP. Maximum 5 MB.
            </small>
        </div>

        @* My Images *@
        <div id="myImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="myImagesSelect">
                My Images
            </label>

            <select id="myImagesSelect"
                    class="form-control">

                <option value="">
                    -- Select image --
                </option>

                @foreach (var image in myImages)
                {
                    <option value="@image.ImageUrl"
                            data-image-id="@image.UserImageId">
                        @image.FileName
                    </option>
                }
            </select>

            <button type="button"
                    id="removeImageButton"
                    class="btn btn-link btn-sm text-secondary text-decoration-none image-selection-hidden">
                Remove image
            </button>
        </div>

        @* Default Images *@
        <div id="defaultImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="defaultImagesSelect">
                Default Images
            </label>

            <select id="defaultImagesSelect"
                    class="form-control">

                <option value="">
                    -- Select image --
                </option>

                @foreach (var image in defaultImages)
                {
                    <option value="@image.ImageUrl">
                        @image.Name
                    </option>
                }
            </select>
        </div>

        <input asp-for="Question.ImageUrl"
               type="hidden"
               id="imageSelect" />

        <span asp-validation-for="Question.ImageUrl"
              class="text-danger">
        </span>

        <div class="mt-3">
            <img id="imagePreview"
                 src=""
                 alt=""
                 class="image-preview" />
        </div>
    </div>

    @* ChallengeId is sent to the controller. *@
    <input type="hidden"
           asp-for="Question.ChallengeId" />

    @* The challenge cannot be changed. *@
    <div class="form-group mb-3">
        <label for="challengeTitle">
            Challenge
        </label>

        <input type="text"
               id="challengeTitle"
               class="form-control"
               value="@challenge?.Title"
               readonly />
    </div>

    <hr />

    @* Used for Single Choice and Multiple Choice. *@
    <div id="choiceAnswerSection" role="group"
         aria-labelledby="answerOptionsHeading" aria-describedby="answerOptionsHelp">
        <h4 id="answerOptionsHeading">Answer Options</h4>

        <span asp-validation-for="Options"
              class="text-danger">
        </span>

        <span asp-validation-for="CorrectOptions"
              class="text-danger">
        </span>

        <p id="answerOptionsHelp" class="text-muted">
            Enter between 2 and 4 answer options.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label asp-for="Options[i]">
                    Option @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="Options[i]"
                       class="form-control" />

                <div class="form-check mt-1">
                    <input type="@(Model.Question.QuestionType == "SingleChoice" ? "radio" : "checkbox")"
                           name="CorrectOptions"
                           value="@i"
                           class="form-check-input correct-option"
                           id="correctOption@(i)"
                           checked="@Model.CorrectOptions.Contains(i)" />

                    <label class="form-check-label"
                           for="correctOption@(i)">
                        Correct answer
                        <span class="visually-hidden">for Option @(i + 1)</span>
                    </label>
                </div>
            </div>
        }
    </div>

    @* Used for Short Answer questions. *@
    <div id="shortAnswerSection"
         class="image-selection-hidden" role="group"
         aria-labelledby="acceptedAnswersHeading" aria-describedby="acceptedAnswersHelp">

        <h4 id="acceptedAnswersHeading">Accepted Answers</h4>

        <span asp-validation-for="AcceptedAnswers"
              class="text-danger">
        </span>

        <p id="acceptedAnswersHelp" class="text-muted">
            Enter between 1 and 4 accepted answers.
        </p>

        @for (int i = 0; i < 4; i++)
        {
            <div class="form-group mb-3">
                <label asp-for="AcceptedAnswers[i]">
                    Accepted Answer @(i + 1)
                </label>

                <input maxlength="200"
                       asp-for="AcceptedAnswers[i]"
                       class="form-control"
                       placeholder="Enter accepted answer" />
            </div>
        }
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Create Question
    </button>

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.Question.ChallengeId"
       class="btn btn-secondary">
        Back to Challenge
    </a>
</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-description.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-type.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/question-form-validation.js"
            asp-append-version="true"
            defer></script>
}
