@model GamificationPlatform.ViewModels.QuestionFormViewModel

@{
    var challenge =
        Model.Challenges.FirstOrDefault(c =>
            c.ChallengeId ==
            Model.Question.ChallengeId);
}

<h2>Create New Question</h2>


<div class="alert alert-warning">
    <strong>Note:</strong>
    Adding a new question will reset all previous attempts
    and scores for this challenge.
</div>


<form asp-controller="Question"
      asp-action="Create"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    <div class="form-group mb-3">

        <label asp-for="Question.Title">
            Title
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Title"
               class="form-control" />

        <span asp-validation-for="Question.Title"
              class="text-danger">
        </span>

    </div>


    <div class="form-group mb-3">

        <label asp-for="Question.Description">
            Description
        </label>

        <input asp-for="Question.Description"
               class="form-control" />

        <span asp-validation-for="Question.Description"
              class="text-danger">
        </span>

    </div>


    <div class="form-group mb-3">

        <label asp-for="Question.Points">
            Points
        </label>

        <span class="text-danger">*</span>

        <input asp-for="Question.Points"
               class="form-control" />

        <span asp-validation-for="Question.Points"
              class="text-danger">
        </span>

    </div>


    <div class="form-group mb-3">

        <label asp-for="Question.ImageUrl">
            Image
        </label>

        <select asp-for="Question.ImageUrl"
                class="form-control">

            <option value="">
                -- No Image --
            </option>

            <option value="/images/Question_mark_code_2.png">
                Question 1
            </option>

            <option value="/images/Question_mark_code_3.png">
                Question 2
            </option>

            <option value="/images/Question_mark_code_4.png">
                Question 3
            </option>

            <option value="/images/Question_mark_code_5.png">
                Question 4
            </option>

            <option value="/images/Question_mark_code_6.png">
                Question 5
            </option>

            <option value="/images/Question_mark_code_7.png">
                Question 6
            </option>

            <option value="/images/Question_mark_code_8.png">
                Question 7
            </option>

            <option value="/images/Question_mark_code_9.png">
                Question 8
            </option>

            <option value="/images/Question_mark_code_10.png">
                Question 9
            </option>

            <option value="/images/Question_mark_code_11.png">
                Question 10
            </option>

        </select>

        <span asp-validation-for="Question.ImageUrl"
              class="text-danger">
        </span>

    </div>


    @* ChallengeId is sent to the controller. *@
    <input type="hidden"
           asp-for="Question.ChallengeId" />


    @* The challenge cannot be changed. *@
    <div class="form-group mb-3">

        <label>
            Challenge
        </label>

        <input type="text"
               class="form-control"
               value="@challenge?.Title"
               readonly />

    </div>


    <hr />


    <h4>Answer Options</h4>

    <p class="text-muted">
        Enter between 2 and 4 answer options.
    </p>


    @for (int i = 0; i < 4; i++)
    {
        <div class="form-group mb-3">

            <label>
                Option @(i + 1)
            </label>

            <input asp-for="Options[i]"
                   class="form-control" />


            <div class="form-check mt-1">

                <input type="radio"
                       asp-for="CorrectOption"
                       value="@i"
                       class="form-check-input" />

                <label class="form-check-label">
                    Correct answer
                </label>

            </div>

        </div>
    }


    <br />


    <button type="submit"
            class="btn btn-primary">
        Create Question
    </button>


    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.Question.ChallengeId"
       class="btn btn-secondary">
        Back to Challenge
    </a>

</form>