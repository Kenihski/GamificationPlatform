@model GamificationPlatform.ViewModels.ChallengeResultViewModel

<h2>Challenge Completed!</h2>

<h4>@Model.ChallengeTitle</h4>

<h3>
    Score: @Model.Score / @Model.MaxScore
</h3>

<p class="mb-4">
    <strong>Time Used:</strong>
    @($"{(int)Model.TimeUsed.TotalMinutes:00}:{Model.TimeUsed.Seconds:00}")
</p>

<hr />

@foreach (var result in Model.QuestionResults)
{
    <div class="card mb-4">
        <div class="card-body">

            <h4>@result.Question.Title</h4>

            @if (!string.IsNullOrWhiteSpace(result.Question.Description))
            {
                <p>@result.Question.Description</p>
            }

            @if (!string.IsNullOrEmpty(result.Question.ImageUrl))
            {
                <img src="@result.Question.ImageUrl"
                     alt="@result.Question.Title"
                     style="width: 300px; height: 180px; object-fit: contain;"
                     class="mb-3" />
            }

            <p>
                <strong>@result.Question.Points points</strong>
            </p>

            @if (result.Question.QuestionType == "ShortAnswer")
            {
                <p>
                    <strong>Your answer:</strong>

                    @if (!string.IsNullOrWhiteSpace(result.TextAnswer))
                    {
                        <span>@result.TextAnswer</span>
                    }
                    else
                    {
                        <span class="text-muted">Not answered</span>
                    }
                </p>
            }
            else
            {
                @foreach (var option in result.Question.Options)
                {
                    <div class="form-check mb-2">

                        @if (result.Question.QuestionType == "MultipleChoice")
                        {
                            <input class="form-check-input"
                                   type="checkbox"
                                   disabled
                                   checked="@result.SelectedOptionIds.Contains(option.QuestionOptionId)" />
                        }
                        else
                        {
                            <input class="form-check-input"
                                   type="radio"
                                   disabled
                                   checked="@result.SelectedOptionIds.Contains(option.QuestionOptionId)" />
                        }

                        <label class="form-check-label">
                            @option.Text
                        </label>

                    </div>
                }
            }

            <hr />

            @if (result.IsCorrect)
            {
                <p class="text-success">
                    <strong>✓ Correct</strong>
                </p>
            }
            else
            {
                <p class="text-danger">
                    <strong>✗ Wrong</strong>
                </p>
            }

            @if (result.Question.QuestionType == "ShortAnswer")
            {
                var acceptedAnswers =
                    result.Question.AcceptedAnswers
                        .Select(answer => answer.Text)
                        .ToList();

                @if (acceptedAnswers.Any())
                {
                    <p>
                        <strong>
                            @(acceptedAnswers.Count == 1
                                ? "Correct answer:"
                                : "Correct answers:")
                        </strong>

                        @string.Join(", ", acceptedAnswers)
                    </p>
                }
            }
            else
            {
                var correctOptions =
                    result.Question.Options
                        .Where(option => option.IsCorrect)
                        .ToList();

                @if (correctOptions.Any())
                {
                    <p>
                        <strong>
                            @(correctOptions.Count == 1
                                ? "Correct answer:"
                                : "Correct answers:")
                        </strong>

                        @string.Join(
                            ", ",
                            correctOptions.Select(option => option.Text))
                    </p>
                }
            }

        </div>
    </div>
}

<a asp-controller="Challenge"
   asp-action="Details"
   asp-route-id="@Model.ChallengeId"
   class="btn btn-secondary">
    Back to Challenge
</a>