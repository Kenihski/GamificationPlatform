
@model GamificationPlatform.ViewModels.ChallengeResultViewModel

@{
    ViewData["Title"] = "Challenge Completed";

    int totalQuestions = Model.QuestionResults.Count;
    int questionNumber = 0;

    int totalSeconds = Math.Max(
        0,
        (int)Math.Round(Model.TimeUsed.TotalSeconds));

    string formattedTime =
        $"{totalSeconds / 60:00}:{totalSeconds % 60:00}";
}

<div class="quiz-result-page">

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="challenge-details-back">
        ← Back to Challenge
    </a>

    <!-- Result summary -->
    <section class="quiz-result-header">

        <span class="quiz-result-label">
            CHALLENGE COMPLETED
        </span>

        <h1>@Model.ChallengeTitle</h1>

        <div class="quiz-result-stats quiz-result-stats-four">

            <div class="quiz-result-stat">
                <span class="quiz-result-stat-label">
                    Score
                </span>

                <strong>
                    @Model.Score / @Model.MaxScore
                </strong>
            </div>

            <div class="quiz-result-stat">
                <span class="quiz-result-stat-label">
                    Time Used
                </span>

                <strong>@formattedTime</strong>
            </div>

            <div class="quiz-result-stat">
                <span class="quiz-result-stat-label">
                    Questions
                </span>

                <strong>@totalQuestions</strong>
            </div>

            <div class="quiz-result-stat">
                <span class="quiz-result-stat-label">
                    Completed
                </span>

                <strong>
                    @(Model.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                </strong>
            </div>

        </div>
    </section>

    @if (!Model.ShowAnswers)
    {
        <!-- Answer review disabled -->
        <div class="quiz-result-hidden-notice"
             role="status">

            <strong>Answers Hidden</strong>

            <p>
                The challenge creator has disabled answer review
                for this challenge. You can still view your overall
                score and points earned for each question.
            </p>

        </div>
    }

    <!-- Question results -->
    @foreach (var result in Model.QuestionResults)
    {
        questionNumber++;

        var question = result.Question;

        bool isAnswered = question.QuestionType == "ShortAnswer"
            ? !string.IsNullOrWhiteSpace(result.TextAnswer)
            : result.SelectedOptionIds.Any();

        <section class="quiz-result-question">

            <div class="quiz-question-heading">

                <span class="quiz-question-number">
                    QUESTION @questionNumber OF @totalQuestions
                </span>

                <span class="quiz-question-points">
                    @result.PointsEarned / @question.Points points
                </span>

            </div>

            <h2 class="quiz-question-title">
                @question.Title
            </h2>

            @if (!string.IsNullOrWhiteSpace(question.Description))
            {
                <p class="quiz-question-description">
                    @question.Description
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(question.ImageUrl))
            {
                <img src="@question.ImageUrl"
                     alt="@question.Title"
                     class="quiz-question-image" />
            }

            @if (Model.ShowAnswers)
            {
                <!-- Submitted answers -->
                @if (question.QuestionType == "ShortAnswer")
                {
                    <div class="quiz-result-text-answer">

                        <span>Your Answer</span>

                        <div class="quiz-result-answer-value">
                            @(string.IsNullOrWhiteSpace(result.TextAnswer)
                                ? "Not answered"
                                : result.TextAnswer)
                        </div>

                    </div>
                }
                else
                {
                    <div class="quiz-result-options">

                        @foreach (var option in question.Options)
                        {
                            bool isSelected = result.SelectedOptionIds
                                .Contains(option.QuestionOptionId);

                            string optionClass = option.IsCorrect
                                ? "quiz-result-option-correct"
                                : isSelected
                                    ? "quiz-result-option-selected"
                                    : "";

                            <div class="quiz-result-option @optionClass">

                                @if (question.QuestionType == "MultipleChoice")
                                {
                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@isSelected"
                                           disabled />
                                }
                                else
                                {
                                    <input type="radio"
                                           class="form-check-input"
                                           checked="@isSelected"
                                           disabled />
                                }

                                <span>@option.Text</span>

                                @if (isSelected)
                                {
                                    <span class="quiz-result-selected-label">
                                        Your answer
                                    </span>
                                }

                                @if (option.IsCorrect)
                                {
                                    <span class="quiz-result-correct-label">
                                        Correct answer
                                    </span>
                                }

                            </div>
                        }

                    </div>
                }

                <!-- Answer feedback -->
                <div class="quiz-result-feedback">

                    @if (!isAnswered)
                    {
                        <span class="quiz-result-status quiz-result-status-unanswered">
                            Not answered
                        </span>
                    }
                    else if (result.IsCorrect)
                    {
                        <span class="quiz-result-status quiz-result-status-correct">
                            ✓ Correct
                        </span>
                    }
                    else
                    {
                        <span class="quiz-result-status quiz-result-status-wrong">
                            ✗ Wrong
                        </span>
                    }

                    @if (question.QuestionType == "ShortAnswer")
                    {
                        var correctAnswers = question.AcceptedAnswers
                            .Select(answer => answer.Text)
                            .ToList();

                        @if (correctAnswers.Any())
                        {
                            <p class="quiz-result-correct-answer">
                                <strong>
                                    @(correctAnswers.Count == 1
                                        ? "Correct answer:"
                                        : "Correct answers:")
                                </strong>

                                @string.Join(", ", correctAnswers)
                            </p>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(question.Explanation))
                    {
                        <div class="quiz-result-explanation">

                            <strong>Explanation</strong>

                            <p>@question.Explanation</p>

                        </div>
                    }

                </div>
            }

        </section>
    }

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="btn btn-outline-primary quiz-result-back-button">
        Back to Challenge
    </a>

</div>
