@model GamificationPlatform.ViewModels.AttemptDetailsViewModel

<h2 class="mb-4">
    Attempt Details
</h2>

<h4>
    @Model.ChallengeTitle
</h4>

<p>
    <strong>Score:</strong>
    @Model.Score / @Model.MaxPoints
</p>

@if (Model.TimeUsed != null)
{
    <p>
        <strong>Time:</strong>
        @Model.TimeUsed
    </p>
}

@if (Model.CompletedAt != null)
{
    <p>
        <strong>Completed:</strong>
        @Model.CompletedAt
    </p>
}

<hr />

@foreach (var answer in Model.Answers)
{
    <div class="card mb-4">
        <div class="card-body">

            <h4>
                @answer.QuestionTitle
            </h4>

            @if (!string.IsNullOrWhiteSpace(answer.QuestionDescription))
            {
                <p>
                    @answer.QuestionDescription
                </p>
            }

            @if (!string.IsNullOrEmpty(answer.ImageUrl))
            {
                <img src="@answer.ImageUrl"
                     alt="@answer.QuestionTitle"
                     style="width: 300px;
                            height: 180px;
                            object-fit: contain;"
                     class="mb-3" />
            }

            <p>
                <strong>
                    @answer.Points points
                </strong>
            </p>

            @if (answer.QuestionType == "ShortAnswer")
            {
                <p>
                    <strong>Your answer:</strong>

                    @if (!string.IsNullOrWhiteSpace(answer.TextAnswer))
                    {
                        <span>@answer.TextAnswer</span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not answered
                        </span>
                    }
                </p>
            }
            else
            {
                @foreach (var option in answer.Options)
                {
                    <div class="form-check mb-2">

                        @if (answer.QuestionType == "MultipleChoice")
                        {
                            <input class="form-check-input"
                                   type="checkbox"
                                   disabled
                                   checked="@option.IsSelected" />
                        }
                        else
                        {
                            <input class="form-check-input"
                                   type="radio"
                                   disabled
                                   checked="@option.IsSelected" />
                        }

                        <label class="form-check-label">
                            @option.Text
                        </label>

                    </div>
                }
            }

            <hr />

            @{
                bool isAnswered =
                    answer.QuestionType == "ShortAnswer"
                        ? !string.IsNullOrWhiteSpace(answer.TextAnswer)
                        : answer.SelectedOptionIds.Any();
            }

            @if (!isAnswered)
            {
                <p class="text-danger">
                    <strong>Not answered</strong>
                </p>
            }
            else if (answer.IsCorrect)
            {
                <p class="text-success">
                    <strong>✓ Correct</strong>
                </p>
            }
            else
            {
                <p class="text-danger">
                    <strong>✗ Wrong</strong>
                </p>
            }

            @if (answer.CorrectAnswers.Any())
            {
                <p>
                    <strong>
                        @(answer.CorrectAnswers.Count == 1
                            ? "Correct answer:"
                            : "Correct answers:")
                    </strong>

                    @string.Join(
                        ", ",
                        answer.CorrectAnswers)
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(answer.QuestionExplanation))
            {
                <div class="alert alert-info mt-3 mb-0">
                    <strong>Explanation:</strong>
                    @answer.QuestionExplanation
                </div>
            }

        </div>
    </div>
}

<a asp-controller="Challenge"
   asp-action="Details"
   asp-route-id="@Model.ChallengeId"
   class="btn btn-secondary">
    Back to Challenge
</a>