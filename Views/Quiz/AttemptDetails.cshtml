@model GamificationPlatform.ViewModels.AttemptDetailsViewModel

<h2 class="mb-4">
    Attempt Details
</h2>

<h4>
    @Model.ChallengeTitle
</h4>

<p>
    <strong>Score:</strong>
    @Model.Score / @Model.MaxPoints
</p>

@if (Model.TimeUsed != null)
{
    <p>
        <strong>Time:</strong>
        @Model.TimeUsed
    </p>
}

@if (Model.CompletedAt != null)
{
    <p>
        <strong>Completed:</strong>
        @Model.CompletedAt
    </p>
}

<hr />

@foreach (var answer in Model.Answers)
{
    <div class="card mb-4">

        <div class="card-body">

            <h4>
                @answer.QuestionTitle
            </h4>

            <p>
                @answer.QuestionDescription
            </p>

            @if (!string.IsNullOrEmpty(answer.ImageUrl))
            {
                <img src="@answer.ImageUrl"
                     alt="@answer.QuestionTitle"
                     style="width: 300px;
                            height: 180px;
                            object-fit: contain;"
                     class="mb-3" />
            }

            <p>
                <strong>
                    @answer.Points points
                </strong>
            </p>

            @foreach (var option in answer.Options)
            {
                <div class="form-check mb-2">

                    <input class="form-check-input"
                           type="radio"
                           disabled
                           checked="@option.IsSelected" />

                    <label class="form-check-label">
                        @option.Text
                    </label>

                </div>
            }

            <hr />

            @if (answer.SelectedOptionId == null)
            {
                <p class="text-danger">
                    <strong>Not answered</strong>
                </p>
            }
            else if (answer.IsCorrect)
            {
                <p class="text-success">
                    <strong>✓ Correct</strong>
                </p>
            }
            else
            {
                <p class="text-danger">
                    <strong>✗ Wrong</strong>
                </p>
            }

            @if (answer.CorrectAnswer != null)
            {
                <p>
                    Correct answer:
                    <strong>
                        @answer.CorrectAnswer
                    </strong>
                </p>
            }

        </div>

    </div>
}

<a asp-controller="Challenge"
   asp-action="Details"
   asp-route-id="@Model.ChallengeId"
   class="btn btn-secondary">
    Back to Challenge
</a>