
@model GamificationPlatform.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<partial name="_FeedbackMessages" />

<!-- Welcome section -->
<section class="home-hero text-center">
    <p class="home-subtitle">
        LEARN • CHALLENGE • IMPROVE
    </p>

    <h1 class="display-4">
        Welcome to the Challenge Hub
    </h1>

    <p class="lead">
        Test your knowledge, complete challenges
        and track your progress.
    </p>

    <div class="home-hero-actions">
        <a asp-controller="Challenge"
           asp-action="Grid"
           class="btn btn-primary btn-lg">
            Browse Challenges
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Challenge"
               asp-action="Create"
               class="btn btn-outline-primary btn-lg">
                Create Challenge
            </a>
        }
        else
        {
            <button type="button"
                    class="btn btn-outline-primary btn-lg"
                    data-bs-toggle="modal"
                    data-bs-target="#registerModal">
                Register
            </button>
        }
    </div>
</section>

<!-- Featured Challenges -->
<section class="home-carousel-section">
    <partial name="_Carousel" />
</section>

<!-- Leaderboards -->
<section class="home-section">
    <div class="row g-4">

        <!-- Core Leaderboard -->
        <div class="col-lg-6">
            <div class="card home-ranking-card h-100">
                <div class="card-body">
                    <div class="home-ranking-header">
                        <div>
                            <p class="home-ranking-label">
                                COMPETE & IMPROVE
                            </p>

                            <h2>
                                Core Leaderboard
                            </h2>
                        </div>

                        <span class="home-ranking-symbol"
                              aria-hidden="true">
                            ⭐
                        </span>
                    </div>

                    @if (Model.CoreLeaderboardEntries.Any())
                    {
                        <div class="home-ranking-list">
                            @foreach (var entry in Model.CoreLeaderboardEntries)
                            {
                                <div class="home-ranking-entry">
                                    <div class="home-ranking-user">
                                        <span class="home-ranking-position">
                                            @entry.Rank
                                        </span>

                                        <span>
                                            @entry.Username
                                        </span>
                                    </div>

                                    <strong>
                                        @entry.TotalPoints.ToString("0.#") pts
                                    </strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-ranking-empty">
                            No Core Challenge results yet.
                        </p>
                    }

                    <a asp-controller="Leaderboard"
                       asp-action="TotalLeaderboard"
                       class="btn btn-outline-primary home-ranking-button">
                        View Core Leaderboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Hall of Fame -->
        <div class="col-lg-6">
            <div class="card home-ranking-card h-100">
                <div class="card-body">
                    <div class="home-ranking-header">
                        <div>
                            <p class="home-ranking-label">
                                UNLOCK ACHIEVEMENTS
                            </p>

                            <h2>
                                Hall of Fame
                            </h2>
                        </div>

                        <span class="home-ranking-symbol"
                              aria-hidden="true">
                            🏆
                        </span>
                    </div>

                    @if (Model.HallOfFameEntries.Any())
                    {
                        <div class="home-ranking-list">
                            @foreach (var entry in Model.HallOfFameEntries)
                            {
                                <div class="home-ranking-entry">
                                    <div class="home-ranking-user">
                                        <span class="home-ranking-position">
                                            @entry.Rank
                                        </span>

                                        <span>
                                            @entry.Username
                                        </span>
                                    </div>

                                    <strong>
                                        @entry.AchievementPoints AP
                                    </strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-ranking-empty">
                            No achievement results yet.
                        </p>
                    }

                    <a asp-controller="HallOfFame"
                       asp-action="Index"
                       class="btn btn-outline-primary home-ranking-button">
                        View Hall of Fame
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="home-section home-features"
         aria-labelledby="howItWorksTitle">

    <h2 id="howItWorksTitle" class="mb-4">
        How It Works
    </h2>

    <div class="row g-4">

        <!-- Core Challenges -->
        <div class="col-md-6">
            <a asp-controller="Challenge"
               asp-action="Grid"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-blue">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M12 7v14" />
                                    <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a1 1 0 0 1-1 1h-4a4 4 0 0 0-4 2 4 4 0 0 0-4-2H4a1 1 0 0 1-1-1Z" />
                                </svg>
                            </div>
                        </div>

                        <h3 class="card-title">
                            Core Challenges
                        </h3>

                        <p class="card-text">
                            Official challenges with individual leaderboards.
                            Your first completed attempt also counts toward
                            the overall Core Leaderboard.
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Community Challenges -->
        <div class="col-md-6">
            <a asp-controller="Challenge"
               asp-action="Grid"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-purple">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                </svg>
                            </div>
                        </div>

                        <h3 class="card-title">
                            Community Challenges
                        </h3>

                        <p class="card-text">
                            User-created challenges with individual leaderboards.
                            Results do not affect the overall Core Leaderboard.
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Core Leaderboard -->
        <div class="col-md-6">
            <a asp-controller="Leaderboard"
               asp-action="TotalLeaderboard"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-purple">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M8 21h8" />
                                    <path d="M12 17v4" />
                                    <path d="M7 4h10v6a5 5 0 0 1-10 0V4Z" />
                                    <path d="M7 6H4v3a4 4 0 0 0 4 4" />
                                    <path d="M17 6h3v3a4 4 0 0 1-4 4" />
                                </svg>
                            </div>
                        </div>

                        <h3 class="card-title">
                            Core Leaderboard
                        </h3>

                        <p class="card-text">
                            An overall ranking combining your results
                            across Core Challenges, with scores
                            normalized to 100 points per challenge.
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Achievements and Hall of Fame -->
        <div class="col-md-6">
            <a asp-controller="HallOfFame"
               asp-action="Index"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-blue">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <circle cx="12" cy="8" r="6" />
                                    <path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12" />
                                    <path d="m12 5 1 2 2 .3-1.5 1.5.4 2.2-1.9-1-1.9 1 .4-2.2L9 7.3l2-.3z" />
                                </svg>
                            </div>
                        </div>

                        <h3 class="card-title">
                            Achievements &amp; Hall of Fame
                        </h3>

                        <p class="card-text">
                            Unlock achievements to earn Achievement
                            Points (AP). Your total AP determines
                            your Hall of Fame ranking.
                        </p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</section>
