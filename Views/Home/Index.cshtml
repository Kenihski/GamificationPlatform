
@model GamificationPlatform.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage"
         class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<!-- Welcome section -->
<section class="home-hero text-center">
    <p class="home-subtitle">
        LEARN • CHALLENGE • IMPROVE
    </p>
    <h1 class="display-4">
        Welcome to Learning Challenge Hub
    </h1>
    <p class="lead">
        Test your knowledge, complete challenges
        and track your progress.
    </p>
    <div class="home-hero-actions">
        <a asp-controller="Challenge"
           asp-action="Grid"
           class="btn btn-primary btn-lg">
            Browse Challenges
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Challenge"
               asp-action="Create"
               class="btn btn-outline-primary btn-lg">
                Create Challenge
            </a>
        }
    </div>
</section>

<!-- Image carousel -->
<section class="home-carousel-section">
    <partial name="_Carousel" />
</section>

<!-- Challenge of the Day -->
<section class="home-section">
    <div class="card home-daily-card">
        <div class="row g-0 align-items-center">
            <div class="col-lg-7">
                <div class="card-body home-daily-content">
                    <p class="home-daily-title">
                        CHALLENGE OF THE DAY
                    </p>
                    @if (Model.ChallengeOfTheDay != null)
                    {
                        <h2 class="home-daily-heading">
                            @Model.ChallengeOfTheDay.Title
                        </h2>
                        <p class="home-daily-description">
                            @Model.ChallengeOfTheDay.Description
                        </p>
                        <div class="home-daily-details">
                            <span>
                                @Model.MaxPoints points
                            </span>
                            <span>
                                @if (Model.ChallengeOfTheDay.TimeLimitMinutes.HasValue)
                                {
                                    @Model.ChallengeOfTheDay.TimeLimitMinutes
                                    <text> min</text>
                                }
                                else
                                {
                                    <text>Unlimited time</text>
                                }
                            </span>
                        </div>
                        <a asp-controller="Challenge"
                           asp-action="Details"
                           asp-route-id="@Model.ChallengeOfTheDay.ChallengeId"
                           class="btn btn-primary home-daily-button">
                            View Challenge
                        </a>
                    }
                    else
                    {
                        <h2 class="home-daily-heading">
                            New challenges coming soon
                        </h2>
                        <p class="home-daily-description">
                            No challenges are available right now.
                        </p>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                @if (Model.ChallengeOfTheDay != null)
                {
                    <div class="home-daily-image-wrapper">
                        <img src="@Model.ChallengeOfTheDay.ImageUrl"
                             alt="@Model.ChallengeOfTheDay.Title"
                             class="home-daily-image" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Leaderboards -->
<section class="home-section">
    <div class="row g-4">
        <!-- Core Leaderboard -->
        <div class="col-lg-6">
            <div class="card home-ranking-card h-100">
                <div class="card-body">
                    <div class="home-ranking-header">
                        <div>
                            <p class="home-ranking-label">
                                COMPETE & IMPROVE
                            </p>
                            <h2>
                                Core Leaderboard
                            </h2>
                        </div>
                        <span class="home-ranking-symbol"
                              aria-hidden="true">
                            ⭐
                        </span>
                    </div>
                    @if (Model.CoreLeaderboardEntries.Any())
                    {
                        <div class="home-ranking-list">
                            @foreach (var entry in Model.CoreLeaderboardEntries)
                            {
                                <div class="home-ranking-entry">
                                    <div class="home-ranking-user">
                                        <span class="home-ranking-position">
                                            @entry.Rank
                                        </span>
                                        <span>
                                            @entry.Username
                                        </span>
                                    </div>
                                    <strong>
                                        @entry.TotalPoints.ToString("0.#") pts
                                    </strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-ranking-empty">
                            No Core Challenge results yet.
                        </p>
                    }
                    <a asp-controller="Leaderboard"
                       asp-action="TotalLeaderboard"
                       class="btn btn-outline-primary home-ranking-button">
                        View Core Leaderboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Hall of Fame -->
        <div class="col-lg-6">
            <div class="card home-ranking-card h-100">
                <div class="card-body">
                    <div class="home-ranking-header">
                        <div>
                            <p class="home-ranking-label">
                                UNLOCK ACHIEVEMENTS
                            </p>
                            <h2>
                                Hall of Fame
                            </h2>
                        </div>
                        <span class="home-ranking-symbol"
                              aria-hidden="true">
                            🏆
                        </span>
                    </div>
                    @if (Model.HallOfFameEntries.Any())
                    {
                        <div class="home-ranking-list">
                            @foreach (var entry in Model.HallOfFameEntries)
                            {
                                <div class="home-ranking-entry">
                                    <div class="home-ranking-user">
                                        <span class="home-ranking-position">
                                            @entry.Rank
                                        </span>
                                        <span>
                                            @entry.Username
                                        </span>
                                    </div>
                                    <strong>
                                        @entry.AchievementPoints AP
                                    </strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-ranking-empty">
                            No achievement results yet.
                        </p>
                    }
                    <a asp-controller="HallOfFame"
                       asp-action="Index"
                       class="btn btn-outline-primary home-ranking-button">
                        View Hall of Fame
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Feature cards -->
<section class="home-section home-features">
    <div class="row g-4">
        <!-- Take Challenges -->
        <div class="col-md-4">
            <a asp-controller="Challenge"
               asp-action="Grid"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-blue">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M8 21h8M12 17v4M7 4h10v6a5 5 0 0 1-10 0V4Z" />
                                    <path d="M7 6H4v3a4 4 0 0 0 4 4M17 6h3v3a4 4 0 0 1-4 4" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="card-title">
                            Take Challenges
                        </h3>
                        <p class="card-text">
                            Test your knowledge with
                            interactive quizzes.
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Track Your Progress -->
        <div class="col-md-4">
            <a asp-controller="Achievement"
               asp-action="Index"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-purple">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     aria-hidden="true">
                                    <path d="M5 20v-6M10 20V9M15 20V5M20 20V2" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="card-title">
                            Track Your Progress
                        </h3>
                        <p class="card-text">
                            View your achievements, earned points, and milestones.
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Leaderboards -->
        <div class="col-md-4">
            <a asp-controller="Leaderboard"
               asp-action="TotalLeaderboard"
               class="home-feature-link">
                <div class="card home-feature-card h-100">
                    <div class="card-body">
                        <div class="home-feature-top">
                            <div class="home-feature-icon home-feature-blue">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="30"
                                     height="30"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="m7 2 5 7 5-7M5 2l7 10L19 2" />
                                    <circle cx="12" cy="16" r="5" />
                                    <path d="m12 13 1 2 2 .3-1.5 1.5.4 2.2-1.9-1-1.9 1 .4-2.2L9 15.3l2-.3z" />
                                </svg>
                            </div>
                        </div>
                        <h3 class="card-title">
                            Leaderboards
                        </h3>
                        <p class="card-text">
                            Compare your best results
                            with other users.
                        </p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

@section Scripts
{
    <script src="~/js/home.js"
            asp-append-version="true"
            defer>
    </script>
}
