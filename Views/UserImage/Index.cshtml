@model IEnumerable<GamificationPlatform.Models.UserImage>

@{
    ViewData["Title"] = "My Images";
}

<div class="container mt-4 mb-5">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1>My Images</h1>
            <p class="text-muted mb-0">Upload and manage images used in your challenges and questions.</p>
        </div>
        <a asp-controller="Challenge" asp-action="MyChallenges"
           class="btn btn-outline-secondary">Back to My Challenges</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Upload an image</h2>
            <form asp-controller="UserImage" asp-action="Upload"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="imageFile" class="form-label">Choose a JPG, PNG or WebP image (maximum 5 MiB)</label>
                    <input type="file" id="imageFile" name="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Upload Image</button>
            </form>
        </div>
    </div>

    <h2 class="h4 mb-3">Uploaded images</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info" role="status">
            You have not uploaded any images yet.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var image in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="ratio ratio-4x3">
                            <img src="@image.ImageUrl" alt="@image.FileName"
                                 class="w-100 h-100 object-fit-cover rounded-top" />
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <p class="card-text text-break mb-0">@image.FileName</p>
                            <form asp-controller="UserImage" asp-action="Delete"
                                  method="post" class="mt-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@image.UserImageId" />
                                <input type="hidden" name="returnUrl"
                                       value="@Url.Action("Index", "UserImage")" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Delete this image?');">
                                    Delete Image
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
