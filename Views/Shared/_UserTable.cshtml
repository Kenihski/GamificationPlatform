
@model IEnumerable<GamificationPlatform.Models.User>
@inject Microsoft.AspNetCore.Identity.UserManager<GamificationPlatform.Models.User> UserManager

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th class="text-center">Id</th>
                <th>Username</th>
                <th>Email</th>
                <th class="text-center">Role</th>
                <th class="text-center">Challenges Created</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="text-center">@user.Id</td>

                    <td>
                        <a asp-controller="User"
                           asp-action="Details"
                           asp-route-id="@user.Id">
                            @user.UserName
                        </a>
                    </td>

                    <td>@user.Email</td>

                    <td class="text-center">
                        @if (await UserManager.IsInRoleAsync(user, "Admin"))
                        {
                            <span class="user-role-badge user-role-admin">
                                Admin
                            </span>
                        }
                        else
                        {
                            <span class="user-role-badge user-role-member">
                                User
                            </span>
                        }
                    </td>

                    <td class="text-center">
                        @user.CreatedChallenges.Count
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
