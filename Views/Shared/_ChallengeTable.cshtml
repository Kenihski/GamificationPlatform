@model ChallengesViewModel

<div class="container">

    <table class="table table-striped align-middle">

        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Type</th>
                <th>Description</th>
                <th>Max Points</th>
                <th>Time Limit</th>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <th>Completed</th>
                }

                <th>Image</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var challenge in Model.Challenges)
            {
                bool isCompleted =
                    Model.CompletedChallengeIds.Contains(
                        challenge.ChallengeId);

                <tr>

                    <td>
                        @challenge.ChallengeId
                    </td>

                    <td>
                        <a asp-controller="Challenge"
                           asp-action="Details"
                           asp-route-id="@challenge.ChallengeId">
                            @challenge.Title
                        </a>
                    </td>

                    <td>
                        @if (challenge.IsCore)
                        {
                            <span class="badge bg-primary">
                                Core
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Community
                            </span>
                        }
                    </td>

                    <td>
                        @challenge.Description
                    </td>

                    <td>
                        @challenge.MaxPoints
                    </td>

                    <td>
                        @if (challenge.TimeLimitMinutes.HasValue)
                        {
                            <span>
                                @challenge.TimeLimitMinutes minutes
                            </span>
                        }
                        else
                        {
                            <span>
                                Unlimited
                            </span>
                        }
                    </td>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <td class="text-center">

                            @if (isCompleted)
                            {
                                <span class="text-success fw-bold fs-4"
                                      title="Completed">
                                    ✓
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    —
                                </span>
                            }

                        </td>
                    }

                    <td>
                        <img src="@challenge.ImageUrl"
                             alt="@challenge.Title"
                             style="max-width: 80px;
                                    max-height: 80px" />
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>