   @model IEnumerable<Challenge>

   <div class="container">
        <table class="table table-striped">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Max Points</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>

            @foreach (var challenge in Model)
            {
                <tr>
                    <td>@challenge.ChallengeId</td>
                    <td>
                    <a asp-controller="Challenge"
                       asp-action="Details"
                       asp-route-id="@challenge.ChallengeId">@challenge.Title</a>
                    </td>
                    <td>@challenge.Description</td>
                    <td>@challenge.MaxPoints</td>
                    <td>
                        <img src="@challenge.ImageUrl" alt="Challenge Image" style="max-width: 80px; max-height: 80px" />
                    </td>
                    <td>
                        <a asp-action="Update" asp-route-id="@challenge.ChallengeId">Update</a>
                        <a asp-action="Delete" asp-route-id="@challenge.ChallengeId">Delete</a>
                    </td>
                </tr>
            }
        </table>
        <p>
            <a class="btn btn-secondary"
              asp-controller="Challenge"
              asp-action="Create">Create New Challenge</a>
        </p>
    </div>

