@model Challenge

@{
    bool isCompleted =
        ViewData["IsCompleted"] as bool? ?? false;
}

<div class="col">

    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="text-decoration-none text-dark">

        <div class="card h-100 challenge-card position-relative">

            @if (isCompleted)
            {
                <div class="completed-corner">
                    <span>✓</span>
                </div>
            }

            <div class="challenge-image-container">
                <img src="@Model.ImageUrl"
                     class="challenge-image"
                     alt="@Model.Title">
            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between
                            align-items-center">

                    @if (Model.IsCore)
                    {
                        <span class="badge bg-primary">
                            Core
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Community
                        </span>
                    }

                    <strong>
                        @Model.MaxPoints points
                    </strong>

                </div>

                <div class="d-flex justify-content-between
                            align-items-center">

                    <h5 class="text-start mb-0">
                        @Model.Title
                    </h5>

                    <span class="small text-muted text-nowrap">

                        @if (Model.TimeLimitMinutes.HasValue)
                        {
                            <span>
                                @Model.TimeLimitMinutes min
                            </span>
                        }
                        else
                        {
                            <span>
                                Unlimited
                            </span>
                        }

                    </span>

                </div>

                <p class="card-text mt-3">
                    @Model.Description
                </p>

            </div>

        </div>

    </a>

</div>