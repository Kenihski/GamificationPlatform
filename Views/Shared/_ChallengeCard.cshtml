
@model Challenge

@{
    bool isCompleted =
        ViewData["IsCompleted"] as bool? ?? false;
}

<div class="col">
    <a asp-controller="Challenge"
       asp-action="Details"
       asp-route-id="@Model.ChallengeId"
       class="challenge-card-link">

        <div class="card h-100 challenge-card position-relative">

            @if (isCompleted)
            {
                <div class="completed-corner">
                    <span>✓</span>
                </div>
            }

            <div class="challenge-image-container">
                <img src="@Model.ImageUrl"
                     class="challenge-image"
                     alt="@Model.Title">
            </div>

            <div class="card-body challenge-card-body">

                <div class="challenge-card-main">

                    <div class="challenge-card-info">

                        @if (Model.IsCore)
                        {
                            <span class="featured-badge featured-badge-core">
                                CORE
                            </span>
                        }
                        else
                        {
                            <span class="featured-badge featured-badge-community">
                                COMMUNITY
                            </span>
                        }

                        <h5 class="challenge-card-title">
                            @Model.Title
                        </h5>

                    </div>

                    <div class="challenge-card-stats">

                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 3 3 5-6" />
                            </svg>

                            @Model.MaxPoints points
                        </span>

                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />
                            </svg>

                            @(Model.TimeLimitMinutes.HasValue
                                ? $"{Model.TimeLimitMinutes} min"
                                : "Unlimited")
                        </span>

                    </div>

                </div>

                <p class="card-text challenge-card-description">
                    @Model.Description
                </p>

            </div>

        </div>
    </a>
</div>
