
@model GamificationPlatform.ViewModels.HomeViewModel

<section class="featured-challenges" aria-labelledby="featuredChallengesTitle">
    <h2 id="featuredChallengesTitle" class="featured-challenges-title">Featured Challenges</h2>

    @if (Model.FeaturedChallenges.Any())
    {
        <div id="featuredChallengesCarousel"
             class="carousel slide featured-carousel"
             data-bs-interval="6000"
             aria-label="Featured challenges">

            @if (Model.FeaturedChallenges.Count > 1)
            {
                <div class="carousel-indicators featured-carousel-indicators">
                    @for (int i = 0; i < Model.FeaturedChallenges.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#featuredChallengesCarousel"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")"
                                aria-current="@(i == 0 ? "true" : "false")"
                                aria-label="Go to challenge @(i + 1)"></button>
                    }
                </div>
            }

            <div class="carousel-inner">
                @for (int i = 0; i < Model.FeaturedChallenges.Count; i++)
                {
                    var featured = Model.FeaturedChallenges[i];
                    var challenge = featured.Challenge;

                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="featured-challenge-card">
                            <div class="featured-challenge-image">
                                @if (!string.IsNullOrWhiteSpace(challenge.ImageUrl))
                                {
                                    <img src="@Url.Content(challenge.ImageUrl)"
                                         alt="@challenge.Title"
                                         loading="@(i == 0 ? "eager" : "lazy")" />
                                }
                            </div>

                            <div class="featured-challenge-content">
                                <div class="featured-challenge-badges">
                                    <span class="featured-badge @(challenge.IsCore ? "featured-badge-core" : "featured-badge-community")">
                                        @(challenge.IsCore ? "CORE" : "COMMUNITY")
                                    </span>
                                    @if (featured.IsPopular)
                                    {
                                        <span class="featured-badge featured-badge-popular">★ POPULAR</span>
                                    }
                                </div>

                                <h3 class="featured-challenge-name">@challenge.Title</h3>
                                <p class="featured-challenge-description">@challenge.Description</p>

                                <div class="featured-challenge-meta">
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m12 2 3.1 6.3 7 1-5 4.9 1.2 7-6.3-3.3-6.3 3.3 1.2-7-5-4.9 7-1L12 2Z" />
                                        </svg>
                                        @featured.MaxPoints points
                                    </span>
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                                        </svg>
                                        @(challenge.TimeLimitMinutes.HasValue ? $"{challenge.TimeLimitMinutes.Value} min" : "Unlimited time")
                                    </span>
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
                                        </svg>
                                        Created by @featured.CreatorUsername
                                    </span>
                                </div>

                                <a asp-controller="Challenge"
                                   asp-action="Details"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-primary featured-challenge-button">
                                    View Challenge <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.FeaturedChallenges.Count > 1)
            {
                <button class="carousel-control-prev featured-carousel-prev"
                        type="button"
                        data-bs-target="#featuredChallengesCarousel"
                        data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous challenge</span>
                </button>
                <button class="carousel-control-next featured-carousel-next"
                        type="button"
                        data-bs-target="#featuredChallengesCarousel"
                        data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next challenge</span>
                </button>
            }
        </div>
    }
    else
    {
        <div class="featured-challenges-empty">
            <p>No published challenges are available yet.</p>
        </div>
    }
</section>
