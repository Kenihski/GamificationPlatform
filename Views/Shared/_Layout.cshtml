
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Learning Challenge Hub</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/achievement-notifications.js" asp-append-version="true" defer></script>
    <script src="~/js/auth-modal.js" asp-append-version="true" defer></script>

    <!-- Matrix background animation -->
    <script src="~/js/matrix-background.js"
            asp-append-version="true"
            defer></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/achievements.css" asp-append-version="true" />
</head>

<body>

    <!-- Animated Matrix background -->
    <canvas id="matrixBackground" aria-hidden="true"></canvas>

    <header>
        <nav class="navbar navbar-dark site-navbar border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Burger menu button -->
                <button class="navbar-toggler me-3"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarMenu"
                        aria-controls="sidebarMenu"
                        aria-label="Open navigation menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Application name -->
                <a class="navbar-brand me-auto"
                   asp-controller="Home"
                   asp-action="Index">
                    Learning Challenge Hub
                </a>

                <!-- Right side -->
                <ul class="navbar-nav flex-row align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link">
                                Welcome, @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-link nav-link">
                                    Logout
                                </button>

                            </form>
                        </li>
                    }
                    else if (!(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
                               (ViewContext.RouteData.Values["action"]?.ToString() == "Login" ||
                                ViewContext.RouteData.Values["action"]?.ToString() == "Register")))
                    {
                        <li class="nav-item">
                            <button type="button"
                                    class="btn btn-primary d-flex align-items-center gap-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#loginModal">

                                <!-- Login icon -->
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="18"
                                     height="18"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     aria-hidden="true">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M10 17l5-5-5-5M15 12H3m9-9h6a3 3 0 013 3v12a3 3 0 01-3 3h-6" />
                                </svg>

                                Login
                            </button>
                        </li>
                    }

                </ul>

            </div>
        </nav>
    </header>

    <!-- Sidebar navigation -->
    <div class="offcanvas offcanvas-start site-sidebar"
         tabindex="-1"
         id="sidebarMenu"
         aria-labelledby="sidebarMenuLabel">

        <div class="offcanvas-header border-bottom">

            <h5 class="offcanvas-title" id="sidebarMenuLabel">
                Learning Challenge Hub
            </h5>

            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>

        <div class="offcanvas-body">

            <!-- Explore section -->
            <h6 class="text-muted fw-bold px-3 mb-3">
                Explore
            </h6>

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Challenge"
                       asp-action="Grid">
                        Challenges
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="HallOfFame"
                       asp-action="Index">
                        Hall of Fame
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Leaderboard"
                       asp-action="TotalLeaderboard">
                        Core Leaderboard
                    </a>
                </li>

            </ul>

            <!-- Logged-in user section -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <hr class="my-3" />

                <h6 class="text-muted fw-bold px-3 mb-3">
                    My Learning
                </h6>

                <ul class="nav flex-column">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Challenge"
                           asp-action="MyChallenges">
                            My Challenges
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Challenge"
                           asp-action="Create">
                            Create Challenge
                        </a>
                    </li>

                    @if (!User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Achievement"
                               asp-action="Index">
                                Achievements
                            </a>
                        </li>
                    }

                </ul>
            }

            <!-- Admin section -->
            @if (User.Identity?.IsAuthenticated == true &&
                 User.IsInRole("Admin"))
            {
                <hr class="my-3" />

                <h6 class="text-muted fw-bold px-3 mb-3">
                    Administration
                </h6>

                <ul class="nav flex-column">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="User"
                           asp-action="Table">
                            Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Question"
                           asp-action="Table">
                            Questions
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Achievement"
                           asp-action="Index">
                            Achievements
                        </a>
                    </li>

                    <!-- Manage uploaded user images -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="UserImage"
                           asp-action="Admin">
                            Manage Images
                        </a>
                    </li>

                </ul>
            }

        </div>
    </div>

    <!-- Login and Register modals -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <!-- Login modal -->
        <div class="modal fade"
             id="loginModal"
             tabindex="-1"
             aria-labelledby="loginModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="loginModalLabel">
                            Login
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">

                        <form id="modalLoginForm"
                              asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            <input type="hidden"
                                   name="isModal"
                                   value="true" />

                            <div id="modalLoginError"
                                 class="alert alert-danger d-none"
                                 role="alert"></div>

                            <div class="mb-3">
                                <label for="modalLoginUsername"
                                       class="form-label">
                                    Username or email
                                </label>

                                <input id="modalLoginUsername"
                                       name="Username"
                                       type="text"
                                       class="form-control"
                                       autocomplete="username"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label for="modalLoginPassword"
                                       class="form-label">
                                    Password
                                </label>

                                <input id="modalLoginPassword"
                                       name="Password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       required />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Login
                            </button>

                        </form>

                        <p class="text-center mt-3 mb-0">
                            Don't have an account?

                            <button type="button"
                                    class="btn btn-link p-0"
                                    data-bs-toggle="modal"
                                    data-bs-target="#registerModal">
                                Register here
                            </button>
                        </p>

                    </div>
                </div>
            </div>
        </div>

        <!-- Register modal -->
        <div class="modal fade"
             id="registerModal"
             tabindex="-1"
             aria-labelledby="registerModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="registerModalLabel">
                            Create Account
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">

                        <form id="modalRegisterForm"
                              asp-controller="Account"
                              asp-action="Register"
                              method="post">

                            <input type="hidden"
                                   name="isModal"
                                   value="true" />

                            <div id="modalRegisterError"
                                 class="alert alert-danger d-none"
                                 role="alert"></div>

                            <div class="mb-3">
                                <label for="modalRegisterUsername"
                                       class="form-label">
                                    Username
                                </label>

                                <input id="modalRegisterUsername"
                                       name="Username"
                                       type="text"
                                       class="form-control"
                                       autocomplete="username"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label for="modalRegisterEmail"
                                       class="form-label">
                                    Email
                                </label>

                                <input id="modalRegisterEmail"
                                       name="Email"
                                       type="email"
                                       class="form-control"
                                       autocomplete="email"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label for="modalRegisterPassword"
                                       class="form-label">
                                    Password
                                </label>

                                <input id="modalRegisterPassword"
                                       name="Password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label for="modalRegisterConfirmPassword"
                                       class="form-label">
                                    Confirm Password
                                </label>

                                <input id="modalRegisterConfirmPassword"
                                       name="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       required />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Register
                            </button>

                        </form>

                        <p class="text-center mt-3 mb-0">
                            Already have an account?

                            <button type="button"
                                    class="btn btn-link p-0"
                                    data-bs-toggle="modal"
                                    data-bs-target="#loginModal">
                                Login here
                            </button>
                        </p>

                    </div>
                </div>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Achievement unlock notifications -->
    @await Component.InvokeAsync("AchievementNotifications")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
