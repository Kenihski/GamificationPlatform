
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Learning Challenge Hub</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/achievement-notifications.js" asp-append-version="true" defer></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/achievements.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Burger menu button -->
                <button class="navbar-toggler me-3"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarMenu"
                        aria-controls="sidebarMenu"
                        aria-label="Open navigation menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Application name -->
                <a class="navbar-brand me-auto"
                   asp-controller="Home"
                   asp-action="Index">
                    Learning Challenge Hub
                </a>

                <!-- Right side -->
                <ul class="navbar-nav flex-row align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-dark">
                                Welcome, @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="User"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-link nav-link text-dark">
                                    Logout
                                </button>

                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="User"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="User"
                               asp-action="Register">
                                Register
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </nav>
    </header>

    <!-- Sidebar navigation -->
    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="sidebarMenu"
         aria-labelledby="sidebarMenuLabel">

        <div class="offcanvas-header border-bottom">

            <h5 class="offcanvas-title" id="sidebarMenuLabel">
                Learning Challenge Hub
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>

        <div class="offcanvas-body">

            <!-- Explore section -->
            <h6 class="text-muted fw-bold px-3 mb-3">
                Explore
            </h6>

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a class="nav-link text-dark"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-dark"
                       asp-controller="Challenge"
                       asp-action="Grid">
                        Challenges
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-dark"
                       asp-controller="HallOfFame"
                       asp-action="Index">
                        Hall of Fame
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-dark"
                       asp-controller="Leaderboard"
                       asp-action="TotalLeaderboard">
                        Core Leaderboard
                    </a>
                </li>

            </ul>

            <!-- Logged-in user section -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <hr class="my-3" />

                <h6 class="text-muted fw-bold px-3 mb-3">
                    My Learning
                </h6>

                <ul class="nav flex-column">

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Challenge"
                           asp-action="MyChallenges">
                            My Challenges
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Challenge"
                           asp-action="Create">
                            Create Challenge
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Achievement"
                           asp-action="Index">
                            Achievements
                        </a>
                    </li>

                </ul>
            }

            <!-- Admin section -->
            @if (User.Identity?.IsAuthenticated == true &&
                 User.IsInRole("Admin"))
            {
                <hr class="my-3" />

                <h6 class="text-muted fw-bold px-3 mb-3">
                    Administration
                </h6>

                <ul class="nav flex-column">

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="User"
                           asp-action="Table">
                            Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Question"
                           asp-action="Table">
                            Questions
                        </a>
                    </li>

                </ul>
            }

        </div>
    </div>

    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- Achievement unlock notifications -->
    @await Component.InvokeAsync("AchievementNotifications")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
