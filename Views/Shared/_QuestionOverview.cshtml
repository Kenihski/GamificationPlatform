@model GamificationPlatform.ViewModels.QuestionOverviewViewModel

@* Question table shared by Challenge Details and Update Challenge. *@
@if (!Model.Questions.Any())
{
    <div class="challenge-details-notice">
        No questions have been added yet.
    </div>
}
else
{
    <div class="table-responsive question-overview">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Answer Options</th>
                    <th>Points</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in Model.Questions.OrderBy(q => q.QuestionId))
                {
                    <tr>
                        <td>
                            <strong>@question.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(question.Description))
                            {
                                <div class="text-muted small mt-1">@question.Description</div>
                            }
                        </td>
                        <td>
                            @if (question.QuestionType == "ShortAnswer")
                            {
                                @foreach (var acceptedAnswer in question.AcceptedAnswers)
                                {
                                    <div>
                                        <span>✓ <strong>@acceptedAnswer.Text</strong></span>
                                    </div>
                                }
                            }
                            else
                            {
                                @foreach (var option in question.Options)
                                {
                                    <div>
                                        @if (option.IsCorrect)
                                        {
                                            <span>✓ <strong>@option.Text</strong></span>
                                        }
                                        else
                                        {
                                            <span>○ @option.Text</span>
                                        }
                                    </div>
                                }
                            }
                        </td>
                        <td>@question.Points</td>
                        <td>
                            <div class="d-flex gap-2 question-overview-actions">
                                <a asp-controller="Question" asp-action="Update"
                                   asp-route-id="@question.QuestionId"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="btn btn-sm btn-outline-warning challenge-question-action">
                                    Edit
                                </a>
                                <a asp-controller="Question" asp-action="Delete"
                                   asp-route-id="@question.QuestionId"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="btn btn-sm btn-outline-danger challenge-question-action">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
