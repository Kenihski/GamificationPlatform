@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="successMessage" class="alert alert-success" role="status">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div id="errorMessage" class="alert alert-danger" role="alert">
        @errorMessage
        @if (TempData["ImageUsageChallenges"] is string imageUsageJson)
        {
            var challenges = System.Text.Json.JsonSerializer.Deserialize<Dictionary<int, string>>(imageUsageJson);
            if (challenges != null && challenges.Count > 0)
            {
                <p class="mt-2 mb-1">Used in:</p>
                <ul>
                    @foreach (var challenge in challenges)
                    {
                        <li>
                            <a asp-controller="Challenge" asp-action="Details"
                               asp-route-id="@challenge.Key" asp-route-showQuestions="true">
                                @challenge.Value (challenge #@challenge.Key)
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    </div>
}
