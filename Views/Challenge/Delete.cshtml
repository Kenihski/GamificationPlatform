
@model Challenge

@{
    ViewData["Title"] = "Delete Challenge";
}

<div class="management-page my-4">
    <h1 class="mb-4">Delete Challenge</h1>
    <p class="text-muted">Review the details and consequences before confirming deletion.</p>

    <div class="card border-danger">
        <div class="card-body">

            <div class="mb-4">
                <h2 class="h4 mb-3">@Model.Title</h2>

                <dl class="row mb-0">

                    <dt class="col-sm-3">
                        Challenge Id
                    </dt>
                    <dd class="col-sm-9">
                        @Model.ChallengeId
                    </dd>

                    <dt class="col-sm-3">
                        Title
                    </dt>
                    <dd class="col-sm-9">
                        @Model.Title
                    </dd>

                    <dt class="col-sm-3">
                        Description
                    </dt>
                    <dd class="col-sm-9">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-3">
                        Max Points
                    </dt>
                    <dd class="col-sm-9">
                        @Model.MaxPoints
                    </dd>

                    <dt class="col-sm-3">
                        Time Limit
                    </dt>
                    <dd class="col-sm-9">
                        @(Model.TimeLimitMinutes.HasValue
                            ? $"{Model.TimeLimitMinutes} minutes"
                            : "Unlimited")
                    </dd>

                    <dt class="col-sm-3">
                        Image
                    </dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt=""
                                 class="img-fluid rounded"
                                 style="max-width: 250px;" />
                        }
                        else
                        {
                            <span class="text-muted">
                                No image selected
                            </span>
                        }
                    </dd>

                </dl>
            </div>

            <div class="alert alert-danger">
                <strong>Warning:</strong> Deleting this challenge permanently removes its questions, answer options, attempts, submitted answers and scores. Its results will also be removed from the leaderboards.

                <div class="mt-2">
                    Are you sure you want to delete this challenge?
                </div>
            </div>

            <form asp-controller="Challenge"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.ChallengeId"
                  method="post"
                  class="d-flex flex-wrap gap-2">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Confirm deletion
                </button>

                <a asp-controller="Challenge"
                   asp-action="MyChallenges"
                   class="btn btn-outline-primary">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>
