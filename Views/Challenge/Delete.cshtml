@model Challenge

@{
    string imageName = Model.ImageUrl switch
    {
        "/images/Question_mark_code_2.png" => "Question 1",
        "/images/Question_mark_code_3.png" => "Question 2",
        "/images/Question_mark_code_4.png" => "Question 3",
        "/images/Question_mark_code_5.png" => "Question 4",
        "/images/Question_mark_code_6.png" => "Question 5",
        "/images/Question_mark_code_7.png" => "Question 6",
        "/images/Question_mark_code_8.png" => "Question 7",
        "/images/Question_mark_code_9.png" => "Question 8",
        "/images/Question_mark_code_10.png" => "Question 9",
        "/images/Question_mark_code_11.png" => "Question 10",
        _ => "No image selected"
    };
}

<h2>Delete Challenge</h2>

<h3>Are you sure you want to delete this challenge?</h3>

<div>
    <h4>Challenge</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">Challenge Id</dt>
        <dd class="col-sm-10">
            @Model.ChallengeId
        </dd>

        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">
            @Model.Title
        </dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">
            @Model.Description
        </dd>

        <dt class="col-sm-2">Max Points</dt>
        <dd class="col-sm-10">
            @Model.MaxPoints
        </dd>

        <dt class="col-sm-2">Time Limit</dt>
        <dd class="col-sm-10">
            @if (Model.TimeLimitMinutes.HasValue)
            {
                <span>
                    @Model.TimeLimitMinutes minutes
                </span>
            }
            else
            {
                <span>
                    Unlimited
                </span>
            }
        </dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @imageName
        </dd>

    </dl>

    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.ChallengeId"
          method="post">

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="MyChallenges"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>