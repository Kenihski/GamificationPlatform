@model Challenge

<h2>Delete Challenge</h2>

<h3>
    Are you sure you want to delete this challenge?
</h3>

<div>
    <h4>Challenge</h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Challenge Id
        </dt>

        <dd class="col-sm-10">
            @Model.ChallengeId
        </dd>


        <dt class="col-sm-2">
            Title
        </dt>

        <dd class="col-sm-10">
            @Model.Title
        </dd>


        <dt class="col-sm-2">
            Description
        </dt>

        <dd class="col-sm-10">
            @Model.Description
        </dd>


        <dt class="col-sm-2">
            Max Points
        </dt>

        <dd class="col-sm-10">
            @Model.MaxPoints
        </dd>


        <dt class="col-sm-2">
            Time Limit
        </dt>

        <dd class="col-sm-10">

            @if (Model.TimeLimitMinutes.HasValue)
            {
                <span>
                    @Model.TimeLimitMinutes minutes
                </span>
            }
            else
            {
                <span>
                    Unlimited
                </span>
            }

        </dd>


        <dt class="col-sm-2">
            Image
        </dt>

        <dd class="col-sm-10">

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid"
                     style="max-width: 250px;" />
            }
            else
            {
                <span class="text-muted">
                    No image selected
                </span>
            }

        </dd>

    </dl>


    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.ChallengeId"
          method="post">

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="MyChallenges"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>