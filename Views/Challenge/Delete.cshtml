
@model Challenge

@{
    ViewData["Title"] = "Delete Challenge";
}

<h2 class="fw-bold mb-4">Delete Challenge</h2>

<div class="alert question-delete-warning mb-4">
    <strong>Warning:</strong> Deleting this challenge will permanently remove it and its associated data.

    <div class="mt-2">
        Are you sure you want to delete this challenge?
    </div>
</div>

<div class="challenge-details-panel mb-4">
    <h4 class="mb-3">Challenge Information</h4>

    <dl class="row mb-0">

        <dt class="col-sm-3">
            Challenge Id
        </dt>
        <dd class="col-sm-9">
            @Model.ChallengeId
        </dd>

        <dt class="col-sm-3">
            Title
        </dt>
        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Max Points
        </dt>
        <dd class="col-sm-9">
            @Model.MaxPoints
        </dd>

        <dt class="col-sm-3">
            Time Limit
        </dt>
        <dd class="col-sm-9">
            @(Model.TimeLimitMinutes.HasValue
                ? $"{Model.TimeLimitMinutes} minutes"
                : "Unlimited")
        </dd>

        <dt class="col-sm-3">
            Image
        </dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="img-fluid rounded"
                     style="max-width: 250px;" />
            }
            else
            {
                <span class="text-muted">
                    No image selected
                </span>
            }
        </dd>

    </dl>
</div>

<form asp-controller="Challenge"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.ChallengeId"
      method="post"
      class="d-flex gap-2">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-outline-danger">
        Delete Challenge
    </button>

    <a asp-controller="Challenge"
       asp-action="MyChallenges"
       class="btn btn-outline-primary">
        Cancel
    </a>

</form>
