@model GamificationPlatform.Models.Challenge

<h1>@Model.Title</h1>

<p>@Model.Description</p>

<hr />

@if (!Model.Questions.Any())
{
    <p>This challenge has no questions yet.</p>
}
else
{
    <form asp-controller="Challenge"
          asp-action="Submit"
          method="post">

        <input type="hidden"
               name="challengeId"
               value="@Model.ChallengeId" />

        @foreach (var question in Model.Questions)
        {
            <div class="card mb-4">
                <div class="card-body">

                    <h4>@question.Title</h4>

                    <p>@question.Description</p>

                    @if (!string.IsNullOrEmpty(question.ImageUrl))
                    {
                        <img src="@question.ImageUrl"
                             alt="@question.Title"
                             style="width: 300px; height: 180px; object-fit: contain;"
                             class="mb-3" />
                    }

                    <p>
                        <strong>@question.Points points</strong>
                    </p>

                    @foreach (var option in question.Options)
                    {
                        <div class="form-check mb-2">

                            <input class="form-check-input"
                                   type="radio"
                                   name="answers[@question.QuestionId]"
                                   value="@option.QuestionOptionId"
                                   id="option_@option.QuestionOptionId" />

                            <label class="form-check-label"
                                   for="option_@option.QuestionOptionId">
                                @option.Text
                            </label>

                        </div>
                    }

                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">
            Submit Answers
        </button>

        <a asp-controller="Challenge"
           asp-action="Details"
           asp-route-id="@Model.ChallengeId"
           class="btn btn-secondary">
            Back to Challenge
        </a>

    </form>
}