@model ChallengesViewModel

<div class="d-flex justify-content-between align-items-center mb-3">

    <h1 class="mb-0">
        List of Challenges
    </h1>

    <div class="btn-group">
        <a asp-controller="Challenge"
           asp-action="Table"
           class="btn btn-primary">
            Table
        </a>

        <a asp-controller="Challenge"
           asp-action="Grid"
           class="btn btn-outline-primary">
            Grid
        </a>
    </div>

</div>

<partial name="_ChallengeTable"
         model="Model.Challenges" />