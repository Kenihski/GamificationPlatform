@model IEnumerable<GamificationPlatform.Models.Challenge>

    <div class="container">
        <h1>@ViewBag.CurrentViewName</h1>

        <table class="table table-striped">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Max Points</th>
            </tr>

            @foreach (var challenge in Model)
            {
                <tr>
                    <td>@challenge.ChallengeId</td>
                    <td>@challenge.Title</td>
                    <td>@challenge.Description</td>
                    <td>@challenge.MaxPoints</td>
                </tr>
            }
        </table>
    </div>


