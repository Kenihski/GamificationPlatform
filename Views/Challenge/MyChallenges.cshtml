@model GamificationPlatform.ViewModels.MyChallengesViewModel

@{
    ViewData["Title"] = "My Challenges";
}

<h2 class="my-4">My Challenges</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage"
         class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage"
         class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Challenges.Any())
{
    <div class="alert alert-info">
        You have not created any challenges yet.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Challenge</th>
                <th>Questions</th>
                <th>Max Points</th>
                <th>Status</th>

                @if (User.IsInRole("Admin"))
                {
                    <th>Type</th>
                }

                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var challenge in Model.Challenges)
            {
                <tr>
                    <td>
                        @challenge.Title
                    </td>

                    <td>
                        @challenge.QuestionCount
                    </td>

                    <td>
                        @challenge.MaxPoints
                    </td>

                    <td>
                        @if (challenge.IsPublished)
                        {
                            <span class="badge bg-success">
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Draft
                            </span>
                        }
                    </td>

                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            @if (challenge.IsCore)
                            {
                                <span class="badge bg-primary">
                                    Core
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Community
                                </span>
                            }
                        </td>
                    }

                    <td>
                        <a asp-controller="Challenge"
                           asp-action="Details"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-info">
                            View
                        </a>

                        <a asp-controller="Challenge"
                           asp-action="Update"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-controller="Challenge"
                           asp-action="Delete"
                           asp-route-id="@challenge.ChallengeId"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                        @if (!challenge.IsPublished)
                        {
                            <form asp-controller="Challenge"
                                  asp-action="Publish"
                                  asp-route-id="@challenge.ChallengeId"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@Context.Request.Path" />

                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    Publish
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Challenge"
                                  asp-action="Unpublish"
                                  asp-route-id="@challenge.ChallengeId"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@Context.Request.Path" />

                                <button type="submit"
                                        class="btn btn-sm btn-dark">
                                    Unpublish
                                </button>

                            </form>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            @if (challenge.IsCore)
                            {
                                <form asp-controller="Challenge"
                                      asp-action="MakeCommunity"
                                      asp-route-id="@challenge.ChallengeId"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@Context.Request.Path" />

                                    <button type="submit"
                                            class="btn btn-sm btn-secondary">
                                        Make Community
                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-controller="Challenge"
                                      asp-action="MakeCore"
                                      asp-route-id="@challenge.ChallengeId"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@Context.Request.Path" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        Make Core
                                    </button>

                                </form>
                            }
                        }
                    </td>
                </tr>
            }

        </tbody>
    </table>
}

<a asp-controller="Challenge"
   asp-action="Create"
   class="btn btn-primary">
    Create New Challenge
</a>

@section Scripts
{
    <script src="~/js/myChallenges.js" defer></script>
}