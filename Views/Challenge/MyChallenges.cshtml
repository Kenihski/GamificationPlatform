
@model GamificationPlatform.ViewModels.MyChallengesViewModel

@{
    ViewData["Title"] = "My Challenges";
}

<div class="my-4">
    <h1 class="fw-bold mb-1">My Challenges</h1>
    <p class="text-secondary mb-0">
        Manage your challenges, edit their content, and control their publication status.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Challenges.Any())
{
    <div class="alert alert-info">
        You have not created any challenges yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Challenge</th>
                    <th class="text-center">Questions</th>
                    <th class="text-center">Max Points</th>
                    <th class="text-center">Status</th>

                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center">Type</th>
                    }

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var challenge in Model.Challenges)
                {
                    <tr>
                        <td>@challenge.Title</td>
                        <td class="text-center">@challenge.QuestionCount</td>
                        <td class="text-center">@challenge.MaxPoints</td>
                        <td class="text-center">
                            @if (challenge.IsPublished)
                            {
                                <span class="challenge-management-status challenge-management-status-published">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="challenge-management-status challenge-management-status-draft">
                                    Draft
                                </span>
                            }
                        </td>

                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-center">
                                @if (challenge.IsCore)
                                {
                                    <span class="featured-badge featured-badge-core challenge-table-badge">CORE</span>
                                }
                                else
                                {
                                    <span class="featured-badge featured-badge-community challenge-table-badge">COMMUNITY</span>
                                }
                            </td>
                        }

                        <td>
                            <div class="d-flex flex-nowrap gap-1 align-items-center my-challenges-actions">
                                <a asp-controller="Challenge" asp-action="Details"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <a asp-controller="Challenge" asp-action="Update"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>

                                <a asp-controller="Challenge" asp-action="Delete"
                                   asp-route-id="@challenge.ChallengeId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                                @if (!challenge.IsPublished)
                                {
                                    <form asp-controller="Challenge" asp-action="Publish"
                                          asp-route-id="@challenge.ChallengeId" method="post">
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Publish
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Challenge" asp-action="Unpublish"
                                          asp-route-id="@challenge.ChallengeId" method="post">
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            Unpublish
                                        </button>
                                    </form>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    @if (challenge.IsCore)
                                    {
                                        <form asp-controller="Challenge" asp-action="MakeCommunity"
                                              asp-route-id="@challenge.ChallengeId" method="post">
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit"
                                                    class="btn btn-sm my-challenges-type-button featured-badge-community"
                                                    title="Change challenge type to Community">
                                                Community
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Challenge" asp-action="MakeCore"
                                              asp-route-id="@challenge.ChallengeId" method="post">
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit"
                                                    class="btn btn-sm my-challenges-type-button featured-badge-core"
                                                    title="Change challenge type to Core">
                                                Core
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Challenge" asp-action="Create" class="btn btn-primary mt-3">
    Create New Challenge
</a>

@section Scripts
{
    <script src="~/js/myChallenges.js" defer></script>
}
