
@model Challenge

@{
    ViewData["Title"] = "Update Challenge";

    var myImages = ViewBag.MyImages as List<GamificationPlatform.Models.UserImage>
        ?? new List<GamificationPlatform.Models.UserImage>();

    var defaultImages = ViewData["DefaultImages"] as List<GamificationPlatform.Models.DefaultImage>
        ?? new List<GamificationPlatform.Models.DefaultImage>();

    var currentImage = Model.ImageUrl ?? "";

    bool isMyImage = myImages.Any(image => image.ImageUrl == currentImage);

    bool isDefaultImage = defaultImages.Any(image => image.ImageUrl == currentImage);

    bool isOtherImage =
        !string.IsNullOrEmpty(currentImage) &&
        !isMyImage &&
        !isDefaultImage;

    string selectedCategory = isMyImage
        ? "my"
        : isDefaultImage
            ? "default"
            : isOtherImage
                ? "current"
                : "none";
}

<h2>Update Challenge</h2>

<form asp-controller="Challenge"
      asp-action="Update"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <input type="hidden"
           asp-for="ChallengeId" />

    <div class="form-group mb-3">
        <label asp-for="Title"></label>
        <span class="text-danger">*</span>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <span class="text-danger">*</span>

        <input asp-for="Description"
               class="form-control" />

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TimeLimitMinutes">
            Time Limit
        </label>

        <select asp-for="TimeLimitMinutes"
                class="form-control">

            <option value="">Unlimited</option>
            <option value="10">10 minutes</option>
            <option value="20">20 minutes</option>
            <option value="30">30 minutes</option>
            <option value="60">60 minutes</option>
            <option value="90">90 minutes</option>
            <option value="120">120 minutes</option>

        </select>

        <span asp-validation-for="TimeLimitMinutes"
              class="text-danger">
        </span>
    </div>

    <!-- Result settings -->
    <div class="form-group mb-3">
        <div class="form-check">
            <input asp-for="ShowAnswersAfterCompletion"
                   class="form-check-input" />

            <label asp-for="ShowAnswersAfterCompletion"
                   class="form-check-label">
                Show answers after completion
            </label>
        </div>

        <small class="text-muted">
            Allow participants to review their answers,
            correct answers and explanations after completing
            the challenge.
        </small>
    </div>

    <!-- Image selection -->
    <div class="form-group mb-4">

        <label for="imageCategory">
            Image
        </label>

        <select id="imageCategory" data-validation-for="ImageUrl"
                class="form-control">

            @if (selectedCategory == "none")
            {
                <option value="none" selected>No image</option>
            }
            else
            {
                <option value="none">No image</option>
            }

            @if (isOtherImage)
            {
                <option value="current" selected>
                    Current image
                </option>
            }

            <option value="upload">
                Upload new image...
            </option>

            @if (selectedCategory == "my")
            {
                <option value="my" selected>My Images</option>
            }
            else
            {
                <option value="my">My Images</option>
            }

            @if (selectedCategory == "default")
            {
                <option value="default" selected>Default Images</option>
            }
            else
            {
                <option value="default">Default Images</option>
            }

        </select>

        <!-- Upload new image -->
        <div id="uploadImageSection"
             class="mt-3 image-selection-hidden">

            <label for="imageUpload">
                Choose image
            </label>

            <input type="file"
                   id="imageUpload"
                   name="imageUpload"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="text-muted">
                JPG, PNG or WebP. Maximum 5 MB.
            </small>

        </div>

        <!-- My Images -->
        <div id="myImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="myImageSelect">
                My Images
            </label>

            <select id="myImageSelect"
                    class="form-control">

                <option value="">
                    -- Select your image --
                </option>

                @foreach (var image in myImages)
                {
                    if (image.ImageUrl == currentImage)
                    {
                        <option value="@image.ImageUrl"
                                data-image-id="@image.UserImageId"
                                selected>
                            @image.FileName
                        </option>
                    }
                    else
                    {
                        <option value="@image.ImageUrl"
                                data-image-id="@image.UserImageId">
                            @image.FileName
                        </option>
                    }
                }

            </select>

            <div class="text-end mt-1">
                <button type="button"
                        id="removeImageButton"
                        class="btn btn-link btn-sm text-secondary text-decoration-none image-selection-hidden">
                    Remove image
                </button>
            </div>

        </div>

        <!-- Default Images -->
        <div id="defaultImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="defaultImageSelect">
                Default Images
            </label>

            <select id="defaultImageSelect"
                    class="form-control">

                <option value="">
                    -- Select default image --
                </option>

                @foreach (var image in defaultImages)
                {
                    if (image.ImageUrl == currentImage)
                    {
                        <option value="@image.ImageUrl" selected>
                            @image.Name
                        </option>
                    }
                    else
                    {
                        <option value="@image.ImageUrl">
                            @image.Name
                        </option>
                    }
                }

            </select>

        </div>

        <!-- Selected image URL -->
        <input asp-for="ImageUrl"
               type="hidden"
               id="imageSelect" />

        <span asp-validation-for="ImageUrl"
              class="text-danger">
        </span>

        <!-- Image preview -->
        <div class="mt-3">
            <img id="imagePreview"
                 src="@currentImage"
                 alt="Selected image preview"
                 class="image-preview" />
        </div>

    </div>

    <button type="submit"
            class="btn btn-outline-warning">
        Save Changes
    </button>

    <a asp-controller="Challenge"
       asp-action="MyChallenges"
       class="btn btn-outline-primary">
        Cancel
    </a>

</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>
}
