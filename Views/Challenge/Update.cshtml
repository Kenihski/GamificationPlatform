
@model Challenge

@{
    ViewData["Title"] = "Update Challenge";

    // Set by the controller only when it is a local URL.
    var returnUrl = ViewData["ReturnUrl"] as string;

    // The question overview starts closed so the form and its buttons come first.
    // It opens automatically when the user returns from a question page.
    bool showQuestions = ViewData["ShowQuestions"] as bool? ?? false;

    // Question pages opened from here come back to this form.
    var questionOverview = new GamificationPlatform.ViewModels.QuestionOverviewViewModel
    {
        ChallengeId = Model.ChallengeId,
        Questions = Model.Questions ?? new List<GamificationPlatform.Models.Question>(),
        ReturnUrl = Url.Action("Update", "Challenge", new { id = Model.ChallengeId, showQuestions = true, returnUrl })
    };

    var myImages = ViewBag.MyImages as List<GamificationPlatform.Models.UserImage>
        ?? new List<GamificationPlatform.Models.UserImage>();

    var defaultImages = ViewData["DefaultImages"] as List<GamificationPlatform.Models.DefaultImage>
        ?? new List<GamificationPlatform.Models.DefaultImage>();

    var fallbackImage = defaultImages.FirstOrDefault(image => image.Name == "Question 1");
    var currentImage = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? fallbackImage?.ImageUrl ?? "" : Model.ImageUrl;

    bool isMyImage = myImages.Any(image => image.ImageUrl == currentImage);

    bool isDefaultImage = defaultImages.Any(image => image.ImageUrl == currentImage);

    bool isOtherImage =
        !string.IsNullOrEmpty(currentImage) &&
        !isMyImage &&
        !isDefaultImage;

    string selectedCategory = isMyImage
        ? "my"
        : isDefaultImage
            ? "default"
            : isOtherImage
                ? "current"
                : "default";
}

<div class="management-page my-4">
    <h1 class="mb-4">Update Challenge</h1>

    <partial name="_FeedbackMessages" />

    <div class="card border-warning">
        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Before saving:</strong> Changes update this challenge's details and settings.
                Existing questions, attempts and scores are kept. Changing answer review settings
                also affects access to answers from previous attempts.
            </div>

            <form asp-controller="Challenge"
                  asp-action="Update"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <input type="hidden"
                       asp-for="ChallengeId" />

                <input type="hidden"
                       name="returnUrl"
                       value="@returnUrl" />

                <div class="form-group mb-3">
                    <label asp-for="Title"></label>
                    <span class="text-danger">*</span>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description"></label>
                    <span class="text-danger">*</span>

                    <input asp-for="Description"
                           class="form-control" />

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TimeLimitMinutes">
                        Time Limit
                    </label>

                    <select asp-for="TimeLimitMinutes"
                            class="form-select">

                        <option value="">Unlimited</option>
                        <option value="10">10 minutes</option>
                        <option value="20">20 minutes</option>
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes</option>
                        <option value="90">90 minutes</option>
                        <option value="120">120 minutes</option>

                    </select>

                    <span asp-validation-for="TimeLimitMinutes"
                          class="text-danger">
                    </span>
                </div>

                <!-- Result settings -->
                <div class="form-group mb-3">
                    <div class="form-check">
                        <input asp-for="ShowAnswersAfterCompletion"
                               class="form-check-input" />

                        <label asp-for="ShowAnswersAfterCompletion"
                               class="form-check-label">
                            Show answers after completion
                        </label>
                    </div>

                    <small class="text-muted">
                        Allow participants to review their answers,
                        correct answers and explanations after completing
                        the challenge.
                    </small>
                </div>

                <!-- Image selection -->
                <div class="form-group mb-4">

                    <label for="imageCategory">
                        Image
                    </label>

                    <select id="imageCategory" data-validation-for="ImageUrl"
                            class="form-select">


                        @if (isOtherImage)
                        {
                            <option value="current" selected>
                                Current image
                            </option>
                        }

                        <option value="upload">
                            Upload new image...
                        </option>

                        @if (selectedCategory == "my")
                        {
                            <option value="my" selected>My Images</option>
                        }
                        else
                        {
                            <option value="my">My Images</option>
                        }

                        @if (selectedCategory == "default")
                        {
                            <option value="default" selected>Default Images</option>
                        }
                        else
                        {
                            <option value="default">Default Images</option>
                        }

                    </select>

                    <p class="form-text text-muted">
                        If no image is selected, Question 1 will be used. You can choose another image.
                    </p>
                    <p id="imageSelectionStatus" role="status" class="text-muted"></p>

                    <!-- Upload new image -->
                    <div id="uploadImageSection"
                         class="mt-3 image-selection-hidden">

                        <label for="imageUpload">
                            Choose image
                        </label>

                        <input type="file"
                               id="imageUpload"
                               name="imageUpload"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <small class="text-muted">
                            JPG, PNG or WebP. Maximum 5 MB.
                        </small>

                    </div>

                    <!-- My Images -->
                    <div id="myImagesSection"
                         class="mt-3 image-selection-hidden">

                        <label for="myImageSelect">
                            My Images
                        </label>

                        <select id="myImageSelect"
                                class="form-select">

                            <option value="">
                                -- Select your image --
                            </option>

                            @foreach (var image in myImages)
                            {
                                if (image.ImageUrl == currentImage)
                                {
                                    <option value="@image.ImageUrl"
                                            selected>
                                        @image.FileName
                                    </option>
                                }
                                else
                                {
                                    <option value="@image.ImageUrl">
                                        @image.FileName
                                    </option>
                                }
                            }

                        </select>


                    </div>

                    <!-- Default Images -->
                    <div id="defaultImagesSection"
                         class="mt-3 image-selection-hidden">

                        <label for="defaultImageSelect">
                            Default Images
                        </label>

                        <select id="defaultImageSelect"
                                class="form-select">

                            <option value="">
                                -- Select default image --
                            </option>

                            @foreach (var image in defaultImages)
                            {
                                if (image.ImageUrl == currentImage)
                                {
                                    <option value="@image.ImageUrl" selected>
                                        @image.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@image.ImageUrl">
                                        @image.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Selected image URL -->
                    <input asp-for="ImageUrl"
                           type="hidden"
                           id="imageSelect" value="@currentImage"
                           data-default-image="@fallbackImage?.ImageUrl" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                    <!-- Image preview -->
                    <div class="mt-3">
                        <img id="imagePreview"
                             src="@currentImage"
                             alt=""
                             class="image-preview" />
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-outline-warning">
                            Save Changes
                        </button>

                        <a href="@(returnUrl ?? Url.Action("MyChallenges", "Challenge"))"
                           class="btn btn-outline-primary">
                            Cancel
                        </a>
                    </div>

                    @* Same toggle as on Challenge Details; it opens the question overview below. *@
                    <button class="btn btn-outline-primary"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#questionOverview"
                            aria-expanded="@(showQuestions ? "true" : "false")"
                            aria-controls="questionOverview">
                        Questions (@questionOverview.Questions.Count())
                    </button>
                </div>

            </form>
        </div>
    </div>

    @* Manage the questions here as well, so editing does not require the details page. *@
    <section id="questionOverview"
             class="card mt-4 collapse@(showQuestions ? " show" : "")"
             aria-labelledby="questionOverviewTitle">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                <h2 id="questionOverviewTitle" class="h4 mb-0">
                    Questions (@questionOverview.Questions.Count())
                </h2>

                <a asp-controller="Question"
                   asp-action="Create"
                   asp-route-challengeId="@Model.ChallengeId"
                   asp-route-returnUrl="@questionOverview.ReturnUrl"
                   class="btn btn-primary">
                    + Add Question
                </a>
            </div>

            <partial name="_QuestionOverview" model="questionOverview" />
        </div>
    </section>
</div>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>

    <script src="~/js/challenge-create-validation.js"
            asp-append-version="true"
            defer></script>
}
