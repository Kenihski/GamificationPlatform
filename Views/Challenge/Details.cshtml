@model GamificationPlatform.ViewModels.ChallengeDetailsHistoryViewModel

<h3 class="my-5">
    @Model.Challenge.Title
</h3>

<div class="row gx-5">

    <img alt="@Model.Challenge.Title"
         src="@Model.Challenge.ImageUrl"
         class="img-fluid col-5" />

    <div class="col">

        <h5>@Model.Challenge.Description</h5>

        <h3>@Model.MaxPoints points</h3>

        <a asp-controller="Challenge"
           asp-action="Take"
           asp-route-id="@Model.Challenge.ChallengeId"
           class="btn btn-primary my-3">
            Start Challenge
        </a>

        <p>
            <a asp-controller="Challenge"
               asp-action="Table">
                Back to Table View
            </a>
        </p>

        <p>
            <a asp-controller="Challenge"
               asp-action="Grid">
                Back to Grid View
            </a>
        </p>

    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <hr class="my-5" />

    <h3>Your History</h3>

    @if (!Model.Attempts.Any())
    {
        <div class="alert alert-info">
            You have no previous attempts for this challenge.
        </div>
    }
    else
    {
        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Status</th>
                    <th>Attempt</th>
                    <th>Time</th>
                    <th>Score</th>
                    <th>Completed</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var attempt in Model.Attempts)
                {
                    // Finds the real attempt number
                    var chronologicalAttempts =
                        Model.Attempts
                            .OrderBy(a => a.CompletedAt)
                            .ToList();

                    int attemptNumber =
                        chronologicalAttempts
                            .FindIndex(a =>
                                a.ChallengeAttemptId ==
                                attempt.ChallengeAttemptId) + 1;

                    // Calculates time used
                    TimeSpan? timeUsed = null;

                    if (attempt.CompletedAt.HasValue)
                    {
                        timeUsed =
                            attempt.CompletedAt.Value -
                            attempt.StartedAt;
                    }

                    bool isBest =
                        attempt.ChallengeAttemptId ==
                        Model.BestAttemptId;

                    bool isLatest =
                        attempt.ChallengeAttemptId ==
                        Model.LatestAttemptId;

                    <tr>

                        <td>
                            @if (isBest && isLatest)
                            {
                                <strong>
                                    BEST / LATEST
                                </strong>
                            }
                            else if (isBest)
                            {
                                <strong>
                                    BEST
                                </strong>
                            }
                            else if (isLatest)
                            {
                                <strong>
                                    LATEST
                                </strong>
                            }
                        </td>

                        <td>
                            <a asp-controller="Challenge"
                            asp-action="AttemptDetails"
                            asp-route-id="@attempt.ChallengeAttemptId">
                                Attempt @attemptNumber
                            </a>
                        </td>

                        <td>
                            @if (timeUsed.HasValue)
                            {
                                if (timeUsed.Value.TotalMinutes >= 1)
                                {
                                    <span>
                                        @Math.Round(timeUsed.Value.TotalMinutes) min
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @Math.Round(timeUsed.Value.TotalSeconds) sec
                                    </span>
                                }
                            }
                        </td>

                        <td>
                            <strong>
                                @attempt.Score / @Model.MaxPoints
                            </strong>
                        </td>

                        <td>
                            @attempt.CompletedAt?.ToString("dd.MM.yyyy HH:mm")
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
}