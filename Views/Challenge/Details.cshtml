@model GamificationPlatform.ViewModels.ChallengeDetailsHistoryViewModel

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage"
         class="alert alert-success mt-4">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage"
         class="alert alert-danger mt-4">
        @TempData["ErrorMessage"]
    </div>
}


<h3 class="my-5">
    @Model.Challenge.Title
</h3>


<div class="row gx-5">

    <img alt="@Model.Challenge.Title"
         src="@Model.Challenge.ImageUrl"
         class="img-fluid col-5" />


    <div class="col">

        <h5>
            @Model.Challenge.Description
        </h5>

        <h3>
            @Model.MaxPoints points
        </h3>

        <p>
            <strong>Created by:</strong>
            @Model.Challenge.CreatedByUser.Username
        </p>

        <p>
            <strong>Time Limit:</strong>

            @if (Model.Challenge.TimeLimitMinutes.HasValue)
            {
                <span>
                    @Model.Challenge.TimeLimitMinutes minutes
                </span>
            }
            else
            {
                <span>
                    Unlimited
                </span>
            }
        </p>


        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Quiz"
               asp-action="Take"
               asp-route-id="@Model.Challenge.ChallengeId"
               class="btn btn-primary my-3">
                Start Challenge
            </a>
        }
        else
        {
            <a asp-controller="User"
               asp-action="Login"
               asp-route-returnUrl="@Url.Action(
                    "Details",
                    "Challenge",
                    new { id = Model.Challenge.ChallengeId })"
               class="btn btn-primary my-3">
                Start Challenge
            </a>
        }


        <a asp-controller="Leaderboard"
           asp-action="Leaderboard"
           asp-route-id="@Model.Challenge.ChallengeId"
           class="btn btn-secondary my-3">
            Leaderboard
        </a>


        <p>
            <a asp-controller="Challenge"
               asp-action="Grid">
                Back to Challenges
            </a>
        </p>

    </div>

</div>


@* Question management is only visible
   to the challenge owner or admin. *@

@if (Model.CanManage)
{
    <hr class="my-5" />


    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#questionOverview"
                aria-expanded="true"
                aria-controls="questionOverview">

            Questions
            (@Model.Challenge.Questions.Count)

        </button>


        <a asp-controller="Question"
           asp-action="Create"
           asp-route-challengeId="@Model.Challenge.ChallengeId"
           class="btn btn-success">
            + Add Question
        </a>

    </div>


    <div class="collapse show"
         id="questionOverview">

        @if (!Model.Challenge.Questions.Any())
        {
            <div class="alert alert-info">
                No questions have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped
                              table-bordered align-middle">

                    <thead>
                        <tr>
                            <th>Question</th>
                            <th>Answer Options</th>
                            <th>Points</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var question in
                            Model.Challenge.Questions
                                .OrderBy(q => q.QuestionId))
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @question.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        question.Description))
                                    {
                                        <div class="text-muted small mt-1">
                                            @question.Description
                                        </div>
                                    }

                                </td>


                                <td>

                                    @foreach (var option in question.Options)
                                    {
                                        <div>

                                            @if (option.IsCorrect)
                                            {
                                                <span>
                                                    ✓
                                                    <strong>
                                                        @option.Text
                                                    </strong>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    ○ @option.Text
                                                </span>
                                            }

                                        </div>
                                    }

                                </td>


                                <td>
                                    @question.Points
                                </td>


                                <td>

                                    <a asp-controller="Question"
                                       asp-action="Update"
                                       asp-route-id="@question.QuestionId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="Question"
                                       asp-action="Delete"
                                       asp-route-id="@question.QuestionId"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
}


@if (User.Identity?.IsAuthenticated == true)
{
    <hr class="my-5" />

    <h3>Your History</h3>


    @if (!Model.Attempts.Any())
    {
        <div class="alert alert-info">
            You have no previous attempts for this challenge.
        </div>
    }
    else
    {
        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Status</th>
                    <th>Attempt</th>
                    <th>Time</th>
                    <th>Score</th>
                    <th>Completed</th>
                </tr>
            </thead>


            <tbody>

                @foreach (var attempt in Model.Attempts)
                {
                    <tr>

                        <td>

                            @if (attempt.IsBest &&
                                 attempt.IsLatest)
                            {
                                <strong>
                                    BEST / LATEST
                                </strong>
                            }
                            else if (attempt.IsBest)
                            {
                                <strong>
                                    BEST
                                </strong>
                            }
                            else if (attempt.IsLatest)
                            {
                                <strong>
                                    LATEST
                                </strong>
                            }

                        </td>


                        <td>

                            <a asp-controller="Quiz"
                               asp-action="AttemptDetails"
                               asp-route-id="@attempt.ChallengeAttemptId">

                                Attempt @attempt.AttemptNumber

                            </a>

                        </td>


                        <td>
                            @attempt.TimeUsed
                        </td>


                        <td>

                            <strong>
                                @attempt.Score / @Model.MaxPoints
                            </strong>

                        </td>


                        <td>
                            @attempt.CompletedAt
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
}


@section Scripts
{
    <script src="~/js/challengeDetails.js" defer></script>
}