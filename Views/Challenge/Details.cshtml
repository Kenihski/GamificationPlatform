
@model GamificationPlatform.ViewModels.ChallengeDetailsHistoryViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Challenge.Title;

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool isOwner = int.TryParse(currentUserId, out int userId) &&
                   Model.Challenge.CreatedByUserId == userId;
    bool isAdmin = User.IsInRole("Admin");
    bool hasQuestions = Model.Challenge.Questions.Any();
    bool canTakeChallenge = hasQuestions &&
        (Model.Challenge.IsPublished || isOwner || isAdmin);
    bool isUnpublishedTest = !Model.Challenge.IsPublished && (isOwner || isAdmin);
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
}

<div class="challenge-details-page">
    <a asp-controller="Challenge" asp-action="Grid" class="challenge-details-back">
        <span aria-hidden="true">←</span> Back to Challenges
    </a>

    <section class="challenge-details-overview" aria-labelledby="challengeDetailsTitle">
        <div class="challenge-details-image">
            <img src="@Model.Challenge.ImageUrl" alt="@Model.Challenge.Title" />
        </div>

        <div class="challenge-details-content">
            <div class="featured-challenge-badges">
                @if (Model.Challenge.IsCore)
                {
                    <span class="featured-badge featured-badge-core">CORE CHALLENGE</span>
                }
                else
                {
                    <span class="featured-badge featured-badge-community">COMMUNITY CHALLENGE</span>
                }

                @if (!Model.Challenge.IsPublished)
                {
                    <span class="challenge-details-draft">DRAFT</span>
                }
            </div>

            <h1 id="challengeDetailsTitle" class="challenge-details-title">
                @Model.Challenge.Title
            </h1>

            <p class="challenge-details-description">@Model.Challenge.Description</p>

            <div class="challenge-details-meta">
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12 3 3 5-6" />
                    </svg>
                    @Model.MaxPoints points
                </span>
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                    @(Model.Challenge.TimeLimitMinutes.HasValue ? $"{Model.Challenge.TimeLimitMinutes} minutes" : "Unlimited time")
                </span>
                <span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                    </svg>
                    Created by @Model.Challenge.CreatedByUser.UserName
                </span>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (canTakeChallenge)
                {
                    @if (isUnpublishedTest)
                    {
                        <div class="alert alert-info">
                            <strong>Unpublished Challenge</strong>
                            <div>This challenge is not published yet. You can take it to test how it works before publishing.</div>
                        </div>
                    }
                }
                else if (!hasQuestions && (isOwner || isAdmin))
                {
                    <div class="alert alert-info">Add at least one question before starting this challenge.</div>
                }
            }

            <div class="challenge-details-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (canTakeChallenge)
                    {
                        <a asp-controller="Quiz" asp-action="Take"
                           asp-route-id="@Model.Challenge.ChallengeId"
                           class="btn btn-primary featured-challenge-button">
                            @(Model.Attempts.Any() ? "Take Challenge Again" : "Start Challenge")
                        </a>
                    }
                }
                else if (Model.Challenge.IsPublished && hasQuestions)
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Challenge", new { id = Model.Challenge.ChallengeId })"
                       class="btn btn-primary featured-challenge-button">
                        Log in to Start Challenge
                    </a>
                }

                <a asp-controller="Leaderboard" asp-action="Leaderboard"
                   asp-route-id="@Model.Challenge.ChallengeId"
                   class="btn btn-outline-primary challenge-details-leaderboard-button">
                    View Leaderboard
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated == true && canTakeChallenge && Model.Attempts.Any() && !isOwner)
            {
                <p class="challenge-details-note">
                    Only your first completed attempt counts toward the leaderboard.
                </p>
            }
        </div>
    </section>

    @* Challenge management is only visible to the challenge owner or admin. *@
    @if (Model.CanManage)
    {
        <section class="challenge-details-panel">
            <h2 class="challenge-details-section-title">Challenge Management</h2>

            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
                <div>
                    <div class="mb-2">
                        <strong>Status:</strong>
                        @if (Model.Challenge.IsPublished)
                        {
                            <span class="challenge-management-status challenge-management-status-published">Published</span>
                        }
                        else
                        {
                            <span class="challenge-management-status challenge-management-status-draft">Draft</span>
                        }
                    </div>

                    <div>
                        <strong>Type:</strong>
                        @if (Model.Challenge.IsCore)
                        {
                            <span class="featured-badge featured-badge-core challenge-table-badge">CORE</span>
                        }
                        else
                        {
                            <span class="featured-badge featured-badge-community challenge-table-badge">COMMUNITY</span>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    @* Only admins can change whether a challenge is Core or Community. *@
                    @if (User.IsInRole("Admin"))
                    {
                        @if (Model.Challenge.IsCore)
                        {
                            <form asp-controller="Challenge" asp-action="MakeCommunity"
                                  asp-route-id="@Model.Challenge.ChallengeId" method="post">
                                <button type="submit" class="btn btn-outline-primary">Make Community</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Challenge" asp-action="MakeCore"
                                  asp-route-id="@Model.Challenge.ChallengeId" method="post">
                                <button type="submit" class="btn btn-outline-primary">Make Core</button>
                            </form>
                        }
                    }

                    @if (Model.Challenge.IsPublished)
                    {
                        <form asp-controller="Challenge" asp-action="Unpublish"
                              asp-route-id="@Model.Challenge.ChallengeId" method="post">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-outline-danger">Unpublish</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Challenge" asp-action="Publish"
                              asp-route-id="@Model.Challenge.ChallengeId" method="post">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-success">Publish</button>
                        </form>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                <button class="btn btn-outline-primary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#questionOverview"
                        aria-expanded="@(Model.ShowQuestions ? "true" : "false")"
                        aria-controls="questionOverview">
                    Questions (@Model.Challenge.Questions.Count)
                </button>

                <a asp-controller="Question" asp-action="Create"
                   asp-route-challengeId="@Model.Challenge.ChallengeId"
                   class="btn btn-primary">
                    + Add Question
                </a>
            </div>

            <div class="collapse@(Model.ShowQuestions ? " show" : "")" id="questionOverview">
                @if (!Model.Challenge.Questions.Any())
                {
                    <div class="alert alert-info">No questions have been added yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Question</th>
                                    <th>Answer Options</th>
                                    <th>Points</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var question in Model.Challenge.Questions.OrderBy(q => q.QuestionId))
                                {
                                    <tr>
                                        <td>
                                            <strong>@question.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(question.Description))
                                            {
                                                <div class="text-muted small mt-1">@question.Description</div>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var option in question.Options)
                                            {
                                                <div>
                                                    @if (option.IsCorrect)
                                                    {
                                                        <span>✓ <strong>@option.Text</strong></span>
                                                    }
                                                    else
                                                    {
                                                        <span>○ @option.Text</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>@question.Points</td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a asp-controller="Question" asp-action="Update"
                                                   asp-route-id="@question.QuestionId"
                                                   class="btn btn-sm btn-outline-warning challenge-question-action">
                                                    Edit
                                                </a>
                                                <a asp-controller="Question" asp-action="Delete"
                                                   asp-route-id="@question.QuestionId"
                                                   class="btn btn-sm btn-outline-danger challenge-question-action">
                                                    Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="challenge-details-panel">
            <h2 class="challenge-details-section-title">Your History</h2>

            @if (!Model.Attempts.Any())
            {
                <div class="challenge-history-empty">
                    You have no previous attempts for this challenge.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Attempt</th>
                                <th>Time</th>
                                <th>Score</th>
                                <th>Completed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in Model.Attempts)
                            {
                                <tr>
                                    <td>
                                        @if (attempt.IsBest && attempt.IsLatest)
                                        {
                                            <strong>BEST / LATEST</strong>
                                        }
                                        else if (attempt.IsBest)
                                        {
                                            <strong>BEST</strong>
                                        }
                                        else if (attempt.IsLatest)
                                        {
                                            <strong>LATEST</strong>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Quiz" asp-action="AttemptDetails"
                                           asp-route-id="@attempt.ChallengeAttemptId">
                                            Attempt @attempt.AttemptNumber
                                        </a>
                                    </td>
                                    <td>@attempt.TimeUsed</td>
                                    <td><strong>@attempt.Score / @Model.MaxPoints</strong></td>
                                    <td>@attempt.CompletedAt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@section Scripts
{
    <script src="~/js/challengeDetails.js" defer></script>
}
