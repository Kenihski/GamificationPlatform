
@model ChallengesViewModel

<div class="mb-4">

    <h1 class="fw-bold mb-2">
        List of Challenges
    </h1>

    <p class="challenge-list-description mb-0">
        Explore available challenges and test your knowledge.
    </p>

</div>

<div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">

    <!-- Challenge category filters -->
    <div class="btn-group" role="group" aria-label="Filter challenges">

        <a asp-controller="Challenge"
           asp-action="Grid"
           asp-route-filter="All"
           class="btn @(Model.CurrentFilter == "All" ? "btn-primary" : "btn-outline-primary")">
            All
        </a>

        <a asp-controller="Challenge"
           asp-action="Grid"
           asp-route-filter="Core"
           class="btn @(Model.CurrentFilter == "Core" ? "btn-primary" : "btn-outline-primary")">
            Core
        </a>

        <a asp-controller="Challenge"
           asp-action="Grid"
           asp-route-filter="Community"
           class="btn @(Model.CurrentFilter == "Community" ? "btn-primary" : "btn-outline-primary")">
            Community
        </a>

    </div>

    <!-- Table and Grid view selection -->
    <div class="btn-group" role="group" aria-label="Choose challenge view">

        <a asp-controller="Challenge"
           asp-action="Table"
           asp-route-filter="@Model.CurrentFilter"
           class="btn btn-outline-primary">
            Table
        </a>

        <a asp-controller="Challenge"
           asp-action="Grid"
           asp-route-filter="@Model.CurrentFilter"
           class="btn btn-primary"
           aria-current="page">
            Grid
        </a>

    </div>

</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

    @foreach (var challenge in Model.Challenges)
    {
        bool isCompleted =
            Model.CompletedChallengeIds.Contains(
                challenge.ChallengeId);

        <partial name="_ChallengeCard"
                 model="challenge"
                 view-data='new ViewDataDictionary(ViewData)
                 {
                     ["IsCompleted"] = isCompleted
                 }' />
    }

</div>
