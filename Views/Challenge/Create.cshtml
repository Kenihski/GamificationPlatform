
@model Challenge

@{
    ViewData["Title"] = "Create Challenge";

    var myImages = ViewBag.MyImages as List<GamificationPlatform.Models.UserImage>
        ?? new List<GamificationPlatform.Models.UserImage>();

    var defaultImages = ViewData["DefaultImages"] as List<GamificationPlatform.Models.DefaultImage>
        ?? new List<GamificationPlatform.Models.DefaultImage>();
}

<h2 class="my-4">Create New Challenge</h2>

<form asp-controller="Challenge"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="form-group mb-3">
        <label asp-for="Title">
            Title
        </label>
        <span class="text-danger">*</span>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description">
            Description
        </label>
        <span class="text-danger">*</span>

        <input asp-for="Description"
               class="form-control" />

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="TimeLimitMinutes">
            Time Limit
        </label>

        <select asp-for="TimeLimitMinutes"
                class="form-control">

            <option value="">Unlimited</option>
            <option value="10">10 minutes</option>
            <option value="20">20 minutes</option>
            <option value="30">30 minutes</option>
            <option value="60">60 minutes</option>
            <option value="90">90 minutes</option>
            <option value="120">120 minutes</option>

        </select>

        <span asp-validation-for="TimeLimitMinutes"
              class="text-danger">
        </span>
    </div>

    <!-- Result settings -->
    <div class="form-group mb-3">
        <div class="form-check">
            <input asp-for="ShowAnswersAfterCompletion"
                   class="form-check-input" />

            <label asp-for="ShowAnswersAfterCompletion"
                   class="form-check-label">
                Show answers after completion
            </label>
        </div>

        <small class="text-muted">
            Allow participants to review their answers,
            correct answers and explanations after completing
            the challenge.
        </small>
    </div>

    <!-- Image selection -->
    <div class="form-group mb-4">

        <label for="imageCategory">
            Image
        </label>

        <select id="imageCategory"
                class="form-control">

            <option value="none">
                No image
            </option>

            <option value="upload">
                Upload new image...
            </option>

            <option value="my">
                My Images
            </option>

            <option value="default">
                Default Images
            </option>

        </select>

        <!-- Upload new image -->
        <div id="uploadImageSection"
             class="mt-3 image-selection-hidden">

            <label for="imageUpload">
                Choose image
            </label>

            <input type="file"
                   id="imageUpload"
                   name="imageUpload"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="text-muted">
                JPG, PNG or WebP. Maximum 5 MB.
            </small>

        </div>

        <!-- My Images -->
        <div id="myImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="myImageSelect">
                My Images
            </label>

            <select id="myImageSelect"
                    class="form-control">

                <option value="">
                    -- Select your image --
                </option>

                @foreach (var image in myImages)
                {
                    <option value="@image.ImageUrl"
                            data-image-id="@image.UserImageId">
                        @image.FileName
                    </option>
                }

            </select>

            <div class="text-end mt-1">
                <button type="button"
                        id="removeImageButton"
                        class="btn btn-link btn-sm text-secondary text-decoration-none image-selection-hidden">
                    Remove image
                </button>
            </div>

        </div>

        <!-- Default Images -->
        <div id="defaultImagesSection"
             class="mt-3 image-selection-hidden">

            <label for="defaultImageSelect">
                Default Images
            </label>

            <select id="defaultImageSelect"
                    class="form-control">

                <option value="">
                    -- Select default image --
                </option>

                @foreach (var image in defaultImages)
                {
                    <option value="@image.ImageUrl">
                        @image.Name
                    </option>
                }

            </select>

        </div>

        <!-- Selected image URL -->
        <input asp-for="ImageUrl"
               type="hidden"
               id="imageSelect" />

        <span asp-validation-for="ImageUrl"
              class="text-danger">
        </span>

        <!-- Image preview -->
        <div class="mt-3">
            <img id="imagePreview"
                 src=""
                 alt="Selected image preview"
                 class="image-preview" />
        </div>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Create Challenge
    </button>

    <a asp-controller="Challenge"
       asp-action="MyChallenges"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>
}
