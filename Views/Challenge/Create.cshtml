@model Challenge

@{
    ViewData["Title"] = "Create Challenge";
}

<h2 class="my-4">Create New Challenge</h2>

<form asp-controller="Challenge"
      asp-action="Create"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="form-group mb-3">
        <label asp-for="Title">
            Title
        </label>
        <span class="text-danger">*</span>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger">
        </span>
    </div>


    <div class="form-group mb-3">
        <label asp-for="Description">
            Description
        </label>
        <span class="text-danger">*</span>

        <input asp-for="Description"
               class="form-control" />

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>


    <div class="form-group mb-3">
        <label asp-for="TimeLimitMinutes">
            Time Limit
        </label>

        <select asp-for="TimeLimitMinutes"
                class="form-control">

            <option value="">
                Unlimited
            </option>

            <option value="10">
                10 minutes
            </option>

            <option value="20">
                20 minutes
            </option>

            <option value="30">
                30 minutes
            </option>

            <option value="60">
                60 minutes
            </option>

            <option value="90">
                90 minutes
            </option>

            <option value="120">
                120 minutes
            </option>

        </select>

        <span asp-validation-for="TimeLimitMinutes"
              class="text-danger">
        </span>
    </div>


    <div class="form-group mb-4">
        <label asp-for="ImageUrl">
            Image
        </label>
        <span class="text-danger">*</span>

        <select asp-for="ImageUrl"
                class="form-control"
                id="imageSelect">

            <option value="">
                -- Select Image --
            </option>

            <option value="/images/Question_1.png">
                Question 1
            </option>

            <option value="/images/Question_2.png">
                Question 2
            </option>

            <option value="/images/Question_3.png">
                Question 3
            </option>

            <option value="/images/Question_4.png">
                Question 4
            </option>

            <option value="/images/Question_5.png">
                Question 5
            </option>

            <option value="/images/Question_6.png">
                Question 6
            </option>

            <option value="/images/Question_7.png">
                Question 7
            </option>

            <option value="/images/Question_8.png">
                Question 8
            </option>

            <option value="/images/Question_9.png">
                Question 9
            </option>

            <option value="/images/Question_10.png">
                Question 10
            </option>

            <option value="/images/Question_11.png">
                Question 11
            </option>

            <option value="/images/Question_12.png">
                Question 12
            </option>

            <option value="/images/Question_13.png">
                Question 13
            </option>

        </select>

        <span asp-validation-for="ImageUrl"
              class="text-danger">
        </span>

        <div class="mt-3">
            <img id="imagePreview"
                 src=""
                 alt="Selected image preview"
                 style="width: 300px;
                        height: 180px;
                        object-fit: contain;
                        display: none;" />
        </div>
    </div>


    <button type="submit"
            class="btn btn-primary">
        Create Challenge
    </button>

    <a asp-controller="Challenge"
       asp-action="Table"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <script src="~/js/image-preview.js"
            asp-append-version="true"
            defer></script>
}
