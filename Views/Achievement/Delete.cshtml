
@model GamificationPlatform.ViewModels.AchievementAdminViewModel

@{
    ViewData["Title"] = "Delete Achievement";
}

<div class="management-page my-4">

    <div class="mb-4">
        <h1>Delete Achievement</h1>

        <p class="text-muted">
            Are you sure you want to delete this achievement?
        </p>
    </div>

    <div class="card border-danger">
        <div class="card-body">

            <h2 class="h4 card-title">
                @Model.Name
            </h2>

            <p class="card-text">
                @Model.Description
            </p>

            <div class="achievement-admin-badges mb-3">
                <span class="achievement-admin-badge achievement-admin-badge-type">
                    @Model.Type
                </span>

                <span class="achievement-admin-badge achievement-admin-badge-requirement">
                    Requirement: @Model.RequirementValue
                </span>

                <span class="achievement-delete-points">
                    @Model.Points AP
                </span>
            </div>

            <div class="alert alert-danger">
                This achievement will be permanently deleted.
                Deleting this achievement will also remove it
                from users who have already unlocked it. Its Achievement Points will no longer
                count toward their totals, which may affect Hall of Fame rankings.
            </div>

            <form asp-controller="Achievement"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.AchievementId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Confirm deletion
                </button>

                <a asp-controller="Achievement"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
