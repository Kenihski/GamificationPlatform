@model GamificationPlatform.ViewModels.AchievementAdminViewModel

@{
    ViewData["Title"] = "Delete Achievement";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h1>Delete Achievement</h1>

        <p class="text-muted">
            Are you sure you want to delete this achievement?
        </p>
    </div>

    <div class="card border-danger">
        <div class="card-body">

            <h4 class="card-title">
                @Model.Name
            </h4>

            <p class="card-text">
                @Model.Description
            </p>

            <div class="mb-3">
                <span class="badge bg-secondary">
                    @Model.Type
                </span>

                <span class="badge bg-secondary">
                    Requirement: @Model.RequirementValue
                </span>

                <span class="badge bg-warning text-dark">
                    @Model.Points AP
                </span>
            </div>

            <div class="alert alert-danger">
                Deleting this achievement will also remove it
                from users who have already unlocked it.
            </div>

            <form asp-controller="Achievement"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.AchievementId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Delete Achievement
                </button>

                <a asp-controller="Achievement"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>